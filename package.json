{
  "name": "peridot-id",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@scarf/scarf",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "js-yaml": "^5.2.3",
      "sharp": "^0.35.3",
      "postcss": "^8.5.18"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @peridotvault/pid-api dev",
    "dev:docs": "pnpm --filter @peridotvault/pid-docs dev",
    "start": "pnpm -r --parallel start",
    "postinstall": "pnpm --filter @peridotvault/pid-types --filter @peridotvault/pid-solana --filter @peridotvault/pid-sdk-js build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @peridotvault/pid-api test",
    "db:migrate": "pnpm --filter @peridotvault/pid-api db:migrate",
    "db:deploy": "pnpm --filter @peridotvault/pid-api db:deploy",
    "db:generate": "pnpm --filter @peridotvault/pid-api db:generate",
    "db:studio": "pnpm --filter @peridotvault/pid-api db:studio"
  }
}
