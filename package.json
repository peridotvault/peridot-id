{
  "name": "peridot-id",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@scarf/scarf",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "js-yaml": "^5.2.3",
      "sharp": "^0.35.3",
      "postcss": "^8.5.18"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @peridotvault/pid-api dev",
    "dev:web": "pnpm --filter @peridotvault/pid-web dev",
    "start": "pnpm -r --parallel start",
    "postinstall": "pnpm --filter @peridotvault/pid-types --filter @peridotvault/pid-core --filter @peridotvault/pid-solana --filter @peridotvault/pid-evm --filter @peridotvault/pid-sdk-js build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @peridotvault/pid-api test",
    "db:migrate": "pnpm --filter @peridotvault/pid-api db:migrate",
    "db:deploy": "pnpm --filter @peridotvault/pid-api db:deploy",
    "db:generate": "pnpm --filter @peridotvault/pid-api db:generate",
    "db:studio": "pnpm --filter @peridotvault/pid-api db:studio"
  },
  "devDependencies": {
    "typescript": "~5.9.0"
  },
  "description": "Gaming Identity Platform — Authentication, Identity, and Profile for the Peridot ecosystem. One Google sign-in, one stable identity, one profile across every Peridot product.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peridotvault/peridot-id.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/peridotvault/peridot-id/issues"
  },
  "homepage": "https://github.com/peridotvault/peridot-id#readme"
}
