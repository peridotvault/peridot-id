{
  "name": "peridot-id",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@scarf/scarf",
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @peridot/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @peridot/api test",
    "db:migrate": "pnpm --filter @peridot/api db:migrate",
    "db:generate": "pnpm --filter @peridot/api db:generate",
    "db:studio": "pnpm --filter @peridot/api db:studio"
  }
}
