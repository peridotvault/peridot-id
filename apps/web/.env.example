# Copy to .env.local and adjust for local dev.
# Web dev server runs on :3301, API on :3300.
NEXT_PUBLIC_PID_API_URL=http://localhost:3300
# Workspace environment badge + cross-env link (production | sandbox).
# Leave unset to derive from the API URL above (loopback = sandbox).
# NEXT_PUBLIC_PID_ENV=sandbox
# NEXT_PUBLIC_PID_OTHER_WORKSPACE_URL=https://sandbox.pid.peridotvault.com/workspace
# Wallet app host the workspace login popup opens (local Vite web). Leave unset
# to derive: loopback API -> localhost:3302, otherwise the env's wallet host.
# NEXT_PUBLIC_PID_POPUP_URL=http://localhost:3302
# Demo sample client_id only (the workspace is first-party — no client_id/secret).
# NEXT_PUBLIC_PID_CLIENT_ID=
