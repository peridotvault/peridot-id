      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "getting-started", "environments", "self-hosting"]
          },
          {
            "group": "Guides",
            "pages": [
              "authentication",
              "sdk",
              "fiat",
              "apps",
              "sign-in-with-peridot-id",
              "embed-wallet",
              "leveling",
              "errors"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api/overview"]
          },
          {
            "group": "Endpoints",
            "openapi": "openapi.yaml"
          }
        ]
      }
    ]
  },
  "api": {
