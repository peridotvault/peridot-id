      "href": "https://dashboard.peridot.id"
    }
  },
  "contextual": {
    "options": ["copy", "view", "download-spec", "chatgpt", "claude"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/peridotvault/peridot-id"
    }
  }
