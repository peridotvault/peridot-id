# Wallet app env (Vite public). Copy to .env.local for local dev.
# Leave unset to default to http://<current-host>:3300 (local API).
VITE_API_URL=http://localhost:3300
# Default network selection. Only "testnet" opts into Testnet Mode by
# default; anything else (or unset) defaults to mainnet (safe default OFF).
# The user can still toggle per-device in Settings — this only sets the default.
#VITE_NETWORK_MODE=mainnet
