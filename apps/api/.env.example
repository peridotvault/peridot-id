# Runtime config for the API (loaded from apps/api, the package CWD)
# PostgreSQL only — refresh-token state lives in the sessions table.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peridot_id

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# ONE identical key set in every environment (local/test/prod) — only the values
# differ. Create a client per environment with its own redirect URI below.
# Local: redirect URI http://localhost:3301/v1/auth/google/callback.
# Prod values live in deploy/.env.main, never here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3301/v1/auth/google/callback

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
# lax (same-site only) | none (cross-site clients, requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
CLIENT_SUCCESS_URL=http://localhost:8081
# Cross-origin SSO returnTo allowlist (comma-separated origins, e.g. relying parties).
# Empty = loopback + registered PidApp origins only.
# CLIENT_REDIRECT_ALLOWLIST=https://live2dev.com
# Optional extra CORS origins, comma-separated (include the web dev server :3300)
CORS_ORIGINS=http://localhost:3300

PORT=3301

# Peridot smart-account program id (deployed program on the target network).
PID_PROGRAM_ID=CiwLJ1hMNjSRdZj2yMVt9BseRTjVd4pjz7Mxr9yXf6NT

# WebAuthn (secp256r1 passkey authority) — comma-separated origins allowed
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PeridotID
WEBAUTHN_ORIGINS=http://localhost:3301,http://localhost:3300,http://localhost:5173,http://localhost:8081

# Solana network for intents (local | devnet | mainnet-beta)
SOLANA_NETWORK=devnet

# Smart-account activation (Peridot-sponsored init with user reimbursement)
# PID_RELAYER_SECRET: 64-byte hex Ed25519 secret of the Peridot relayer keypair (devnet)
# REQUIRED: the relayer pubkey must hold SOL on the target network — it floats fee + rent on
# activation. Without it the tx is dropped and the API returns "activation service out of funds".
#   solana airdrop 5 <relayer pubkey> --url <PID_SOLANA_RPC_URL>
PID_SOLANA_RPC_URL=https://api.devnet.solana.com
PID_RELAYER_SECRET=
PID_ACTIVATION_POLL_MS=10000
PID_ACTIVATION_CONFIRM_ATTEMPTS=15
PID_ACTIVATION_CONFIRM_INTERVAL_MS=1000
PID_TREASURY_PUBKEY=
# Signed fee-policy version (selects the fixed protocol percentage; must be supported on-chain, V1 = 1 = 50%)
PID_FEE_POLICY_VERSION=1

# EVM counterfactual accounts (CREATE2, one address per chain from the pid).
# The factory + implementation MUST be the same address on every chain or the
# same-address guarantee breaks — deploy via contracts/evm (keyless CREATE2 first).
# Until these are set, EVM rows are skipped and the /evm/* endpoints 503.
EVM_FACTORY_ADDRESS=
EVM_IMPLEMENTATION_ADDRESS=
# Optional csv subset of chain references to provision (default: all four).
# EVM_CHAIN_REFERENCES=10143,97,421614,84532
# RPCs: per-chain override or shared fallback.
EVM_RPC_URL=https://rpc.ankr.com/eth_sepolia
# EVM_RPC_URL_10143=https://testnet-rpc.monad.xyz
# EVM_RPC_URL_97=https://data-seed-prebsc-1-s1.binance.org:8545
# EVM_RPC_URL_421614=https://sepolia-rollup.arbitrum.io/rpc
# EVM_RPC_URL_84532=https://sepolia.base.org
# Relayer deploy key (0x 32-byte hex). Unset = operator deploys via forge script,
# POST .../activate then only confirms ACTIVE.
# EVM_RELAYER_SECRET=
# V3: the factory itself is the canonical revenue vault (no separate treasury address).
PID_EVM_POLL_MS=30000

# Fiat: DOKU Sub-Account V2 (1 PID → 1 Sub-Account). Peridot is
# identity/orchestration, DOKU is the authoritative ledger.
# Values live in apps/api/.env, never here.
DOKU_MODE=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# RSA private key PEM (multiline, double-quoted with \n escapes) from the
# DOKU dashboard. Signs B2B token requests. Required for all Sub-Account calls.
DOKU_PRIVATE_KEY=
# Sub-account type for register (DEFAULT for standard sub-accounts).
DOKU_SAC_TYPE=DEFAULT
# Hierarchy: Peridot ID (merchant root) → Users (parent for EVERY PID
# financial account; 1 PID = 1 User Sub-Account) and Peridot ID → Treasury
# (separate system sub-account for fee settlement, never under Users).
# Users + Treasury are provisioned once via the DOKU dashboard; paste their
# IDs/numbers here. Never create product-specific parents (no Live2Dev /
# Peridot split — one balance per PID).
# DOKU_USERS_PARENT_PROFILE_ID=
# DOKU_TREASURY_PROFILE_ID=
# DOKU_TREASURY_ACCOUNT_NO=
# Static fiat split rules are RETIRED — fees move as Treasury POINTS at
# issuance, and a fiat split on top would double-charge. The
# POST /v1/fiat/sub-accounts/admin/split-rules passthrough remains for
# future fiat-side use only; do NOT wire any rule ID into payments.
# (Historical note: DOKU_SPLIT_RULE_ID was removed for exactly this reason.)
# Unified Ledger (spendable points, 1:1 IDR peg) — Phase 0 ops:
# activate the service with DOKU, then verify DOKU_SYSTEM_POINT exists via a
# merchant-profile balance inquiry and paste its account number here.
# Issuance fails safe (deferred, retryable) until this is set.
# DOKU_SYSTEM_POINT_ACCOUNT_NO=
# Treasury POINT account (fee revenue, redeemable). Preferred explicit;
# falls back to resolving via DOKU_TREASURY_PROFILE_ID (cached 5 min).
# DOKU_TREASURY_POINT_ACCOUNT_NO=
# Legacy single-parent var (fallback for DOKU_USERS_PARENT_PROFILE_ID).
# DOKU_SAC_PARENT_PROFILE_ID=
# Public webhook URL registered in the DOKU dashboard (≤64 chars, HTTPS).
# DOKU_WEBHOOK_URL=https://api.example.com/v1/fiat/sub-accounts/webhook
# Per-payment Checkout notify override (additional_info.override_notification_url).
# Defaults to DOKU_WEBHOOK_URL when unset.
# DOKU_CHECKOUT_NOTIFY_URL=https://api.example.com/v1/fiat/sub-accounts/webhook

# Admin bootstrap: no admin exists initially, so the first one is promoted
# directly (run once):
#   psql $DATABASE_URL -c "UPDATE identities SET role='admin' WHERE pid='handle@pid';"
# Admin UI lives in the same /workspace (Chains tab, role-gated); enforcement
# is server-side (AdminGuard), never frontend-only.
