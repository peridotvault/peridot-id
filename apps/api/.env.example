# Runtime config for the API (loaded from apps/api, the package CWD)
# PostgreSQL only — refresh-token state lives in the sessions table.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peridot_id

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3301/v1/auth/google/callback

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
# lax (same-site only) | none (cross-site clients, requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
CLIENT_SUCCESS_URL=http://localhost:5173
# Optional extra CORS origins, comma-separated
CORS_ORIGINS=

PORT=3301

# Peridot smart-account program id (devnet placeholder — set the deployed program in task 005)
PID_PROGRAM_ID=CiwLJ1hMNjSRdZj2yMVt9BseRTjVd4pjz7Mxr9yXf6NT

# WebAuthn (passkey authority, ADR 005) — comma-separated origins allowed
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PeridotID
WEBAUTHN_ORIGINS=http://localhost:3301,http://localhost:5173,http://localhost:8081

# Solana network for intents (local | devnet | mainnet-beta)
SOLANA_NETWORK=devnet

# Smart-account activation (Peridot-sponsored init with user reimbursement)
# PID_RELAYER_SECRET: 64-byte hex Ed25519 secret of the Peridot relayer keypair (devnet)
# REQUIRED: the relayer pubkey must hold SOL on the target network — it floats fee + rent on
# activation. Without it the tx is dropped and the API returns "activation service out of funds".
#   solana airdrop 5 <relayer pubkey> --url <PID_SOLANA_RPC_URL>
PID_SOLANA_RPC_URL=https://api.devnet.solana.com
PID_RELAYER_SECRET=
PID_ACTIVATION_MARGIN_RATE=0.5
PID_ACTIVATION_POLL_MS=10000
PID_ACTIVATION_CONFIRM_ATTEMPTS=15
PID_ACTIVATION_CONFIRM_INTERVAL_MS=1000
PID_TREASURY_PUBKEY=
