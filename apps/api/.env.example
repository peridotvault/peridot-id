# Runtime config for the API (loaded from apps/api, the package CWD)
# PostgreSQL only — refresh-token state lives in the sessions table.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peridot_id

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3301/v1/auth/google/callback

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
# lax (same-site only) | none (cross-site clients, requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
CLIENT_SUCCESS_URL=http://localhost:5173
# Optional extra CORS origins, comma-separated
CORS_ORIGINS=

PORT=3301

# Peridot smart-account program id (devnet placeholder — set the deployed program in task 005)
PID_PROGRAM_ID=G8tPCQRqZAg5R2TDGkcRKw8vZN3tJMdtyHGbaQhW5o4G

# WebAuthn (passkey authority, ADR 005) — comma-separated origins allowed
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PeridotID
WEBAUTHN_ORIGINS=http://localhost:3301,http://localhost:5173,http://localhost:8081

# Solana network for intents (local | devnet | mainnet-beta)
SOLANA_NETWORK=devnet
