
# SECREET
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peridot_id

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DOKU_MODE=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PRIVATE_KEY=
DOKU_SAC_TYPE=DEFAULT

PID_RELAYER_SECRET=
PID_TREASURY_PUBKEY=

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# Dedicated server pepper for email-OTP code hashes (ANT-285(c)) — REQUIRED in
# deployed envs. Long random value (32+ bytes hex). Fallback is HKDF-derived
# from JWT_REFRESH_SECRET; provision the dedicated value for full separation.
EMAIL_OTP_PEPPER=
# Optional: dedicated HMAC secret for OAuth state envelopes. When unset, the
# key is HKDF-derived from JWT_ACCESS_SECRET (domain-separated, F1) — set this
# in deployed envs for full key isolation.

# One-time ops bootstrap (ANT-227): PIDs listed here claim with the admin role,
# but ONLY while no admin exists yet. Set for the very first deploy, claim the
# admin, then REMOVE this variable (the API warns at startup while it is set).
# Format: comma-separated PIDs, e.g. PID_BOOTSTRAP_ADMIN_PID=ifal@pid,ops@pid
PID_BOOTSTRAP_ADMIN_PID=

# Optional server pepper for app client-secret hashes (ANT-227): sha256(pepper:secret).
# Pre-pepper sha256(secret) rows keep verifying until rotated. Long random value.
PID_APP_SECRET_PEPPER=

BREVO_API_KEY=

# URL
PORT=3300

API_URL=http://localhost:3300
WALLET_URL=http://localhost:3302
DASHBOARD_URL=http://localhost:3303

PID_REDEMPTION_ENABLED=false