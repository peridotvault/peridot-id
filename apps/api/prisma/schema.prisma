generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityStatus {
  active
  suspended
  deleted
}

model Identity {
  id        String         @id
  status    IdentityStatus @default(active)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  profile     Profile?
  credentials IdentityCredential[]
  devices     Device[]
  wallets     Wallet[]

  @@map("identities")
}

model Profile {
  id                String   @id @default(uuid())
  identityId        String   @unique
  identity          Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  username          String?  @unique
  usernameChangedAt DateTime?
  displayName       String?
  avatarUrl         String?
  locale            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("profiles")
}

model IdentityCredential {
  id             String   @id @default(uuid())
  identityId     String
  identity       Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  provider       String
  providerUserId String
  email          String?
  linkedAt       DateTime @default(now())
  lastLoginAt    DateTime?

  @@unique([provider, providerUserId])
  @@map("identity_credentials")
}

model Device {
  id         String   @id @default(uuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  sessions   Session[]

  @@map("devices")
}

model Session {
  id          String   @id
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  rotatedFrom String?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@map("sessions")
}

model Wallet {
  id         String         @id @default(uuid())
  identityId String         @unique
  identity   Identity       @relation(fields: [identityId], references: [id], onDelete: Cascade)
  chain      String
  address    String
  status     IdentityStatus @default(active)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // ADR 003: `onDelete: Cascade` is defensive, matching the identity -> credential/device
  // convention. PID deletion is soft (status/deletedAt); the wallet soft-deletes with the
  // PID, so the hard cascade is never reached. One wallet per PID via `identityId @unique`.
  // No key material or provider (Google) fields — record-only custody (ADR 003).
  @@map("wallets")
}
