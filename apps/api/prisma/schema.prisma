generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityStatus {
  active
  suspended
  deleted
}

enum Role {
  user
  admin
}

enum AuthorityStatus {
  active
  revoked
}

enum IntentStatus {
  pending
  approved
  executed
  expired
  rejected
  cancelled
}

enum TransactionStatus {
  prepared
  submitted
  confirmed
  failed
}

enum ChainAccountStatus {
  inactivated
  funded
  ready
  activating
  active
  insufficient
}

model Identity {
  // Permanent ecosystem PID: `<handle>@pid` (e.g. `ifal@pid`). App-supplied,
  // user-chosen once at onboarding. Immutable (PK), never reused or reassigned
  // — deleted rows keep their PK reserved. Case-insensitive uniqueness holds by
  // storing the lowercased form (see common/pid.ts).
  pid       String         @id
  status    IdentityStatus @default(active)
  role      Role           @default(user)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  profile     Profile?
  credentials IdentityCredential[]
  devices     Device[]

  chainAccounts ChainAccount[]
  authorities   Authority[]
  intents       Intent[]
  transactions  Transaction[]
  challenges    CredentialChallenge[]
  securityEvents  SecurityEvent[]
  pidApps PidApp[]

  @@map("identities")
}

model Profile {
  // Strict 1:1 with Identity — shared primary key, no surrogate UUID.
  pid               String   @id
  identity          Identity @relation(fields: [pid], references: [pid], onDelete: Cascade)
  displayName       String?
  avatarUrl         String?
  locale            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("profiles")
}

model IdentityCredential {
  id             String   @id @default(uuid())
  pid            String
  identity       Identity @relation(fields: [pid], references: [pid], onDelete: Cascade)
  provider       String
  providerUserId String
  email          String?
  linkedAt       DateTime @default(now())
  lastLoginAt    DateTime?

  @@unique([provider, providerUserId])
  @@index([pid])
  @@map("identity_credentials")
}

model Device {
  id         String   @id @default(uuid())
  pid        String
  identity   Identity @relation(fields: [pid], references: [pid], onDelete: Cascade)
  userAgent  String?
  // How this session family authenticated ("google" | "passkey"). Null on
  // pre-existing rows, treated as "google" (shorter cap). Preserved across
  // refresh rotations, which keep the same device.
  authMethod String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  sessions   Session[]

  @@index([pid])
  @@map("devices")
}

model Session {
  id          String   @id
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  rotatedFrom String?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt  DateTime @default(now())

  @@index([deviceId])
  @@map("sessions")
}

// 1 identity = 1 personal wallet. The PidAccount hub is gone — every
// wallet-owned row references Identity.pid directly. (A future multisig product
// will be a separate wallet model shared by many identities, not this one.)

// Single-use, expiring WebAuthn ceremony state. No secret material — the challenge
// is a random nonce (PRD_v4 §22: replay protection). `approvalChallenge` carries the
// existing-credential approval required to add a second credential.
model CredentialChallenge {
  id                String           @id @default(uuid())
  pid               String?
  identity          Identity?  @relation(fields: [pid], references: [pid], onDelete: Cascade)
  kind              String
  challenge         String
  approvalChallenge String?
  isAdditional      Boolean          @default(false)
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime         @default(now())

  @@index([pid])
  @@map("credential_challenges")
}

// One row per chain account of the identity's single personal wallet.
// `account_type` = smart_account (program PDA) or linked_address (migrated V3
// record-only). The unique constraint encodes one smart account per chain.
// The chain is a single `chainId` FK — namespace/reference live once on `chains` and
// are read back through the join (never duplicated here).
// No key-material columns, ever (long-standing rule).
model ChainAccount {
  id                 String            @id @default(uuid())
  pid                String
  identity           Identity @relation(fields: [pid], references: [pid], onDelete: Cascade)
  chainId            String
  chain              Chain             @relation(fields: [chainId], references: [id], onDelete: Restrict)
  address            String
  accountType        String
  status             ChainAccountStatus @default(inactivated)
  activationBalance  BigInt?     // lamports detected at last poll (null = unpolled)
  activationRequired BigInt?     // lamports needed to activate (rent+fee+margin)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  feePayers    WalletFeePayer[]
  transactions Transaction[]

  @@unique([pid, chainId, accountType])
  @@index([chainId])
  @@map("chain_accounts")
}

// Signing authority for the identity's personal wallet. Public material
// only — the secret never leaves the client authenticator (passkey/secp256r1).
model Authority {
  id           String          @id @default(uuid())
  pid          String
  identity     Identity  @relation(fields: [pid], references: [pid], onDelete: Cascade)
  type         String
  publicKey    Bytes
  credentialId String?
  status       AuthorityStatus @default(active)
  createdAt    DateTime        @default(now())
  lastUsedAt   DateTime?

  @@index([pid])
  @@map("authorities")
}

// User-controlled fee payer — address only; the key never leaves the client.
model WalletFeePayer {
  id             String         @id @default(uuid())
  chainAccountId String
  chainAccount   ChainAccount   @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)
  address        String
  status         IdentityStatus @default(active)
  createdAt      DateTime       @default(now())

  @@index([chainAccountId])
  @@map("wallet_fee_payers")
}

// PRD_v4 §5.4: application expresses a desired action; validated, policy-checked,
// and given an expiry before anything is signed.
model Intent {
  id        String         @id @default(uuid())
  pid       String
  identity  Identity @relation(fields: [pid], references: [pid], onDelete: Cascade)
  type      String
  payload   Json
  status    IntentStatus   @default(pending)
  createdAt DateTime       @default(now())
  expiresAt DateTime

  transactions Transaction[]

  @@index([pid])
  @@map("intents")
}

model Transaction {
  id             String            @id @default(uuid())
  pid            String
  identity       Identity    @relation(fields: [pid], references: [pid], onDelete: Cascade)
  chainAccountId String
  chainAccount   ChainAccount      @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)
  intentId       String?
  intent         Intent?           @relation(fields: [intentId], references: [id], onDelete: SetNull)
  type           String?
  amount         BigInt?
  asset          String?
  direction      String?
  counterparty   String?
  chain          String
  network        String
  txHash         String?
  status         TransactionStatus @default(prepared)
  createdAt      DateTime          @default(now())
  confirmedAt    DateTime?
  errorCode      String?
  errorMessage   String?

  @@index([pid])
  @@index([chainAccountId])
  @@index([intentId])
  @@map("transactions")
}

// PRD_v4 §22: audit log written by auth, credential, wallet, and program-facing
// flows. Metadata is JSONB; never contains secrets.
model SecurityEvent {
  id         String           @id @default(uuid())
  pid        String
  identity   Identity         @relation(fields: [pid], references: [pid], onDelete: Cascade)
  eventType  String
  metadata   Json
  createdAt  DateTime         @default(now())

  @@index([pid])
  @@map("security_events")
}

// Pending post-auth PID claims (Google-only entry). A verified credential with no
// identity yet: the claim UI picks a handle, then one transaction creates the
// identity + profile + credential and consumes the ticket. 10-min TTL, single-use,
// nothing is created until claim — abandoning restarts cleanly on next login.
model ClaimTicket {
  id             String    @id @default(uuid())
  provider       String
  providerUserId String
  email          String?
  displayName    String?
  avatarUrl      String?
  redirectTo     String?
  clientId       String?
  consumedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
  @@map("claim_tickets")
}

// One-time, expiring authorization codes for cross-domain SSO (OAuth-like). Issued
// after a successful Google/passkey login when a relying party (e.g. Live2Dev on a
// different origin) asked to be returned to. The code rides in the redirect URL and is
// exchanged server-to-server — no cookie sharing across sites. Single-use, ~5 min TTL.
model SsoCode {
  id         String    @id @default(uuid())
  code       String    @unique
  pid        String
  sessionId  String?
  redirectTo String
  clientId   String?
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([pid])
  @@map("sso_codes")
}

// Persistent relying-party grants ("App connections"). Written when an SSO
// pid_code is exchanged; revoking stops future code issuance to that origin.
// It cannot end the relying party's own session (standard OAuth limitation).
model SsoGrant {
  id          String   @id @default(uuid())
  pid         String
  origin      String
  clientId    String?
  firstSeenAt DateTime @default(now())
  lastUsedAt  DateTime @default(now())
  revokedAt   DateTime?

  @@unique([pid, origin])
  @@map("sso_grants")
}

// Chain registry (admin-managed). Chains and their typed contracts (factory,
// account implementation, …) live here instead of env files so the wallet and
// activation flows render whatever is active — adding a chain is a data row.
// Secrets (relayer keys, RPC API keys) stay in env, never here.
model Chain {
  id           String   @id @default(uuid())
  namespace    String
  reference    String
  name         String
  nativeSymbol String
  decimals     Int      @default(18)
  rpcUrls      String[]
  explorerUrl  String?
  logoUrl      String?
  isTestnet    Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contracts ChainContract[]
  accounts  ChainAccount[]

  @@unique([namespace, reference])
  @@map("chains")
}

model ChainContract {
  id           String   @id @default(uuid())
  chainId      String
  chain        Chain    @relation(fields: [chainId], references: [id], onDelete: Cascade)
  type         String
  address      String
  versionLabel String?
  deployTxHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([chainId, type])
  @@map("chain_contracts")
}

// Registered third-party apps ("Sign in with PeridotID"). Any developer registers an
// app, gets a public client_id, and manages the allowed origins its users may be
// returned to (the exact return URL is passed in code at login time). The same list
// gates browser API calls (CORS).
model PidApp {
  id           String   @id @default(uuid())
  clientId     String   @unique
  ownerPid     String
  owner        Identity @relation(fields: [ownerPid], references: [pid], onDelete: Cascade)
  name         String
  allowedOrigins String[]
  isActive     Boolean  @default(true)
  // Optional backend secret (confidential clients). SHA-256 hex, never plaintext.
  // When set, code exchange requires the matching secret.
  clientSecretHash      String?
  clientSecretPrefix    String?
  clientSecretCreatedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerPid])
  @@map("pid_apps")
}
