generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityStatus {
  active
  suspended
  deleted
}

enum AuthorityStatus {
  active
  revoked
}

enum IntentStatus {
  pending
  approved
  executed
  expired
  rejected
  cancelled
}

enum TransactionStatus {
  prepared
  submitted
  confirmed
  failed
}

enum ChainAccountStatus {
  inactivated
  funded
  ready
  activating
  active
  insufficient
}

model Identity {
  id        String         @id
  status    IdentityStatus @default(active)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  profile     Profile?
  credentials IdentityCredential[]
  devices     Device[]

  pidAccounts PidAccount[]
  securityEvents  SecurityEvent[]
  pidApps PidApp[]

  @@map("identities")
}

model Profile {
  id                String   @id @default(uuid())
  identityId        String   @unique
  identity          Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  username          String?  @unique
  usernameChangedAt DateTime?
  displayName       String?
  avatarUrl         String?
  locale            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("profiles")
}

model IdentityCredential {
  id             String   @id @default(uuid())
  identityId     String
  identity       Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  provider       String
  providerUserId String
  email          String?
  linkedAt       DateTime @default(now())
  lastLoginAt    DateTime?

  @@unique([provider, providerUserId])
  @@map("identity_credentials")
}

model Device {
  id         String   @id @default(uuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  sessions   Session[]

  @@map("devices")
}

model Session {
  id          String   @id
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  rotatedFrom String?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@map("sessions")
}

// ADR 004: PeridotID account — the wallet-owning entity. V1 creates exactly one default
// account per identity (API exposes 1); schema permits many so a future multi-account
// product needs no migration.
model PidAccount {
  id         String         @id @default(uuid())
  identityId String
  identity   Identity       @relation(fields: [identityId], references: [id], onDelete: Cascade)
  status     IdentityStatus @default(active)
  version    Int            @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  chainAccounts  ChainAccount[]
  authorities    Authority[]
  transactions   Transaction[]
  intents        Intent[]
  securityEvents SecurityEvent[]
  challenges     CredentialChallenge[]

  @@map("pid_accounts")
}

// ADR 005: single-use, expiring WebAuthn ceremony state. No secret material — the challenge
// is a random nonce (PRD_v4 §22: replay protection). `approvalChallenge` carries the
// existing-credential approval required to add a second credential (ADR 006 §4).
model CredentialChallenge {
  id                String           @id @default(uuid())
  accountId         String?
  account           PidAccount?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind              String
  challenge         String
  approvalChallenge String?
  isAdditional      Boolean          @default(false)
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime         @default(now())

  @@index([accountId])
  @@map("credential_challenges")
}

// ADR 004: one row per chain account. `account_type` = smart_account (program PDA) or
// linked_address (migrated V3 record-only). The unique constraint encodes one smart
// account per chain per account in V1 while letting a migrated linked_address coexist.
// No key-material columns, ever (ADR 003 rule carried).
model ChainAccount {
  id                 String            @id @default(uuid())
  accountId          String
  account            PidAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chainNamespace     String
  chainReference     String
  address            String
  accountType        String
  status             ChainAccountStatus @default(inactivated)
  activationBalance  BigInt?     // lamports detected at last poll (null = unpolled)
  activationRequired BigInt?     // lamports needed to activate (rent+fee+margin)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  feePayers    WalletFeePayer[]
  transactions Transaction[]

  @@unique([accountId, chainNamespace, chainReference, accountType])
  @@map("chain_accounts")
}

// ADR 004/005: signing authority for a PeridotID account. Public material only — the
// secret never leaves the client authenticator (passkey/secp256r1) or device.
model Authority {
  id           String          @id @default(uuid())
  accountId    String
  account      PidAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type         String
  publicKey    Bytes
  credentialId String?
  status       AuthorityStatus @default(active)
  createdAt    DateTime        @default(now())
  lastUsedAt   DateTime?

  @@index([accountId])
  @@map("authorities")
}

// ADR 006: user-controlled fee payer — address only; the key never leaves the client.
model WalletFeePayer {
  id             String         @id @default(uuid())
  chainAccountId String
  chainAccount   ChainAccount   @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)
  address        String
  status         IdentityStatus @default(active)
  createdAt      DateTime       @default(now())

  @@index([chainAccountId])
  @@map("wallet_fee_payers")
}

// ADR 004/PRD_v4 §5.4: application expresses a desired action; validated, policy-checked,
// and given an expiry before anything is signed.
model Intent {
  id        String         @id @default(uuid())
  accountId String
  account   PidAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  status    IntentStatus   @default(pending)
  createdAt DateTime       @default(now())
  expiresAt DateTime

  transactions Transaction[]

  @@index([accountId])
  @@map("intents")
}

model Transaction {
  id             String            @id @default(uuid())
  accountId      String
  account        PidAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chainAccountId String
  chainAccount   ChainAccount      @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)
  intentId       String?
  intent         Intent?           @relation(fields: [intentId], references: [id], onDelete: SetNull)
  type           String?
  amount         BigInt?
  asset          String?
  direction      String?
  counterparty   String?
  chain          String
  network        String
  txHash         String?
  status         TransactionStatus @default(prepared)
  createdAt      DateTime          @default(now())
  confirmedAt    DateTime?
  errorCode      String?
  errorMessage   String?

  @@index([accountId])
  @@index([chainAccountId])
  @@map("transactions")
}

// ADR 004/PRD_v4 §22: audit log written by auth, credential, wallet, and program-facing
// flows. Metadata is JSONB; never contains secrets.
model SecurityEvent {
  id         String           @id @default(uuid())
  identityId String
  identity   Identity         @relation(fields: [identityId], references: [id], onDelete: Cascade)
  accountId  String?
  account    PidAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  eventType  String
  metadata   Json
  createdAt  DateTime         @default(now())

  @@index([identityId])
  @@index([accountId])
  @@map("security_events")
}

// One-time, expiring authorization codes for cross-domain SSO (OAuth-like). Issued
// after a successful Google/passkey login when a relying party (e.g. Live2Dev on a
// different origin) asked to be returned to. The code rides in the redirect URL and is
// exchanged server-to-server — no cookie sharing across sites. Single-use, ~5 min TTL.
model SsoCode {
  id         String    @id @default(uuid())
  code       String    @unique
  identityId String
  sessionId  String?
  redirectTo String
  clientId   String?
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([identityId])
  @@map("sso_codes")
}

// Registered third-party apps ("Sign in with PeridotID"). Any developer registers an
// app, gets a public client_id, and lists the redirect URIs PeridotID may return
// pid_codes to. Allowed CORS origins are derived from the redirect URIs.
model PidApp {
  id             String   @id @default(uuid())
  clientId       String   @unique
  ownerId        String
  owner          Identity @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  redirectUris   String[]
  allowedOrigins String[]
  isActive       Boolean  @default(true)
  // Optional backend secret (confidential clients). SHA-256 hex, never plaintext.
  // When set, code exchange requires the matching secret.
  clientSecretHash      String?
  clientSecretPrefix    String?
  clientSecretCreatedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId])
  @@map("pid_apps")
}
