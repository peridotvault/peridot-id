generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityStatus {
  active
  suspended
  deleted
}

enum Role {
  user
  admin
}

enum AuthorityStatus {
  active
  revoked
}

enum IntentStatus {
  pending
  approved
  executed
  expired
  rejected
  cancelled
}

enum TransactionStatus {
  prepared
  submitted
  confirmed
  failed
}

enum ChainAccountStatus {
  inactivated
  funded
  ready
  activating
  active
  insufficient
}

model Identity {
  // Permanent ecosystem PID: `<handle>@pid` (e.g. `ifal@pid`). App-supplied,
  // user-chosen once at onboarding. Immutable (PK), never reused or reassigned
  // — deleted rows keep their PK reserved. Case-insensitive uniqueness holds by
  // storing the lowercased form (see common/pid.ts).
  pid       String         @id
  status    IdentityStatus @default(active)
  role      Role           @default(user)
  createdAt DateTime @db.Timestamptz(3)       @default(now())
  updatedAt DateTime @db.Timestamptz(3)       @updatedAt
  deletedAt DateTime? @db.Timestamptz(3)

  // Back-refs below are Prisma-mandatory declarations (a relation needs both
  // sides); they cost nothing at runtime. Convention: never `include` from
  // Identity — query the child delegate directly (see docs/DATABASE.md).
  // Auth & profile.
  profile     Profile?
  credentials IdentityCredential[]
  devices     Device[]
  challenges  CredentialChallenge[]
  // Wallet (1 identity = 1 personal wallet).
  chainAccounts ChainAccount[]
  authorities   Authority[]
  intents       Intent[]
  transactions  Transaction[]
  // Platform: third-party apps, audit log.
  securityEvents SecurityEvent[]
  pidApps        PidApp[]
  // Relayer hardening (ANT-581 H2): at-most-once broadcast ledger.
  relayerBroadcasts RelayerBroadcast[]
  // Money rails (journals; Postgres is journal+cache, DOKU is the ledger —
  // internal credit excepted, see docs/INTERNAL_CREDIT.md).
  fiatProviderAccounts     FiatProviderAccount[]
  fiatProviderTransactions FiatProviderTransaction[]
  fiatLedgerEntries    FiatLedgerEntry[]
  // XP & Leveling (ANT-89 M1): derived state + append-only XP journal.
  // Unlike money, XP is non-financial reputation — pid FKs below Cascade so
  // account deletion cleans XP rows instead of blocking it (fiat Restricts).
  xpState            UserXpState?
  xpLedgerEntries    XpLedgerEntry[]
  xpTaskCompletions  XpTaskCompletion[]
  xpSuspiciousEvents XpSuspiciousActivity[]
  xpOrgQuota         XpOrgQuota?

  @@map("identities")
}

model Profile {
  // Strict 1:1 with Identity — shared primary key, no surrogate UUID.
  pid         String   @id
  identity    Identity @relation(fields: [pid], references: [pid], onDelete: Cascade)
  displayName String?
  avatarUrl   String?
  locale      String?
  createdAt   DateTime @db.Timestamptz(3) @default(now())
  updatedAt   DateTime @db.Timestamptz(3) @updatedAt

  @@map("profiles")
}

model IdentityCredential {
  id             String    @id @default(uuid())
  pid            String
  identity       Identity  @relation(fields: [pid], references: [pid], onDelete: Cascade)
  provider       String
  providerUserId String
  // Globally unique per non-null email (one email = one PID). Case-insensitive
  // enforcement lives in a raw-SQL functional index (see migration
  // 20261023_identity_credential_email_lower_uniq): UNIQUE lower(email) WHERE
  // email IS NOT NULL — Prisma cannot express it here. Claim flow maps the
  // P2002 violation to 409 (ANT-233 F3).
  email          String?
  linkedAt       DateTime @db.Timestamptz(3)  @default(now())
  lastLoginAt    DateTime? @db.Timestamptz(3)

  @@unique([provider, providerUserId])
  @@index([pid])
  @@map("identity_credentials")
}

model Device {
  id         String    @id @default(uuid())
  pid        String
  identity   Identity  @relation(fields: [pid], references: [pid], onDelete: Cascade)
  userAgent  String?
  // How this session family authenticated ("google" | "email" | "passkey"). Null on
  // pre-existing rows, treated as "google" (shorter cap). Preserved across
  // refresh rotations, which keep the same device.
  authMethod String?
  lastSeenAt DateTime @db.Timestamptz(3)  @default(now())
  createdAt  DateTime @db.Timestamptz(3)  @default(now())
  sessions   Session[]

  @@index([pid])
  @@map("devices")
}

model Session {
  id          String    @id
  deviceId    String
  device      Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  rotatedFrom String?
  revokedAt   DateTime? @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)
  createdAt   DateTime @db.Timestamptz(3)  @default(now())

  @@index([deviceId])
  @@map("sessions")
}

// 1 identity = 1 personal wallet. The PidAccount hub is gone — every
// wallet-owned row references Identity.pid directly. (A future multisig product
// will be a separate wallet model shared by many identities, not this one.)

// Single-use, expiring WebAuthn ceremony state. No secret material — the challenge
// is a random nonce (PRD_v4 §22: replay protection). `approvalChallenge` carries the
// existing-credential approval required to add a second credential.
model CredentialChallenge {
  id                String    @id @default(uuid())
  pid               String?
  identity          Identity? @relation(fields: [pid], references: [pid], onDelete: Cascade)
  kind              String
  challenge         String
  approvalChallenge String?
  isAdditional      Boolean   @default(false)
  expiresAt         DateTime @db.Timestamptz(3)
  consumedAt        DateTime? @db.Timestamptz(3)
  createdAt         DateTime @db.Timestamptz(3)  @default(now())

  @@index([pid])
  @@map("credential_challenges")
}

// One row per chain account of the identity's single personal wallet.
// `account_type` = smart_account (program PDA) or linked_address (migrated V3
// record-only). The unique constraint encodes one smart account per chain.
// The chain is a single `chainId` FK — namespace/reference live once on `chains` and
// are read back through the join (never duplicated here).
// No key-material columns, ever (long-standing rule).
model ChainAccount {
  id                 String             @id @default(uuid())
  pid                String
  identity           Identity           @relation(fields: [pid], references: [pid], onDelete: Cascade)
  chainId            String
  chain              Chain              @relation(fields: [chainId], references: [id], onDelete: Restrict)
  address            String
  accountType        String
  status             ChainAccountStatus @default(inactivated)
  activationBalance  BigInt? // lamports detected at last poll (null = unpolled)
  activationRequired BigInt? // lamports needed to activate (rent+fee+margin)
  createdAt          DateTime @db.Timestamptz(3)           @default(now())
  updatedAt          DateTime @db.Timestamptz(3)           @updatedAt

  feePayers    WalletFeePayer[]
  transactions Transaction[]

  @@unique([pid, chainId, accountType])
  @@index([chainId])
  @@map("chain_accounts")
}

// Signing authority for the identity's personal wallet. Public material
// only — the secret never leaves the client authenticator (passkey/secp256r1).
model Authority {
  id           String          @id @default(uuid())
  pid          String
  identity     Identity        @relation(fields: [pid], references: [pid], onDelete: Cascade)
  type         String
  publicKey    Bytes
  credentialId String?
  status       AuthorityStatus @default(active)
  createdAt    DateTime @db.Timestamptz(3)        @default(now())
  lastUsedAt   DateTime? @db.Timestamptz(3)

  @@index([pid])
  @@map("authorities")
}

// User-controlled fee payer — address only; the key never leaves the client.
model WalletFeePayer {
  id             String         @id @default(uuid())
  chainAccountId String
  chainAccount   ChainAccount   @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)
  address        String
  status         IdentityStatus @default(active)
  createdAt      DateTime @db.Timestamptz(3)       @default(now())

  @@unique([chainAccountId, address])
  @@map("wallet_fee_payers")
}

// PRD_v4 §5.4: application expresses a desired action; validated, policy-checked,
// and given an expiry before anything is signed.
model Intent {
  id        String       @id @default(uuid())
  pid       String
  identity  Identity     @relation(fields: [pid], references: [pid], onDelete: Cascade)
  type      String
  payload   Json
  status    IntentStatus @default(pending)
  createdAt DateTime @db.Timestamptz(3)     @default(now())
  expiresAt DateTime @db.Timestamptz(3)

  transactions Transaction[]

  @@index([pid])
  @@map("intents")
}

model Transaction {
  id             String            @id @default(uuid())
  pid            String
  identity       Identity          @relation(fields: [pid], references: [pid], onDelete: Cascade)
  chainAccountId String
  chainAccount   ChainAccount      @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)
  intentId       String?
  intent         Intent?           @relation(fields: [intentId], references: [id], onDelete: SetNull)
  type           String?
  amount         BigInt?
  asset          String?
  direction      String?
  counterparty   String?
  chain          String
  network        String
  // Globally unique when set (chain signatures are unique ids). NULLs are
  // exempt (Postgres allows multiple NULLs in a UNIQUE index) — intents that
  // never reach a chain keep NULL. Enforced at the DB level (ANT-254); the
  // recordTransaction replay check is the UX-friendly 400 on top.
  txHash         String?         @unique
  status         TransactionStatus @default(prepared)
  createdAt      DateTime @db.Timestamptz(3)          @default(now())
  confirmedAt    DateTime? @db.Timestamptz(3)
  errorCode      String?
  errorMessage   String?

  @@index([pid])
  @@index([chainAccountId])
  @@index([intentId])
  @@map("transactions")
}

// PRD_v4 §22: audit log written by auth, credential, wallet, and program-facing
// flows. Metadata is JSONB; never contains secrets.
model SecurityEvent {
  id        String   @id @default(uuid())
  pid       String
  identity  Identity @relation(fields: [pid], references: [pid], onDelete: Cascade)
  eventType String
  metadata  Json
  createdAt DateTime @db.Timestamptz(3) @default(now())

  @@index([pid])
  @@map("security_events")
}

// ANT-581 H2: at-most-once broadcast ledger per (pid, nonce, chain).
// `nonce` holds the replay-protection scalar: the SVM account nonce, or the
// EVM authorization deadline (EVM has no nonce). `txBytesHash` is the sha256
// of the exact bytes submitted — identical-bytes retries reuse the row, while
// DIFFERENT bytes under the SAME nonce are forbidden (no conflicting
// submissions). Expand-only (new table, no data movement).
model RelayerBroadcast {
  id          String   @id @default(uuid())
  pid         String
  identity    Identity @relation(fields: [pid], references: [pid], onDelete: Cascade)
  nonce       String
  chain       String
  entryPoint  String
  txBytesHash String
  signature   String?
  // claimed|submitted|confirmed|failed|expired|rebroadcast|resolved-landed|
  // resolved-not-landed-rebroadcast|parked-unreadable
  // Unique key includes entryPoint (F4): a terminally-failed withdraw must not
  // block an execute under the same chain nonce. The on-chain nonce still
  // prevents double-execution, so per-entry slots lose no replay safety.
  status      String   @default("claimed")
  createdAt   DateTime @db.Timestamptz(3) @default(now())
  updatedAt   DateTime @db.Timestamptz(3) @updatedAt

  @@unique([pid, nonce, chain, entryPoint])
  @@index([pid])
  @@map("relayer_broadcasts")
}

// Pending post-auth PID claims (Google + email-OTP entry). A verified credential
// with no identity yet: the claim UI picks a handle, then one transaction creates
// the identity + profile + credential and consumes the ticket. 10-min TTL,
// single-use, nothing is created until claim — abandoning restarts cleanly.
model ClaimTicket {
  id             String    @id @default(uuid())
  provider       String
  providerUserId String
  email          String?
  displayName    String?
  avatarUrl      String?
  redirectTo     String?
  clientId       String?
  consumedAt     DateTime? @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @db.Timestamptz(3)  @default(now())

  @@index([expiresAt])
  @@map("claim_tickets")
}

// Email-OTP login challenges (Brevo sender, auth-only). One row per request:
// the 6-digit code is never stored — only its SHA-256 hash. 10-min TTL,
// max 5 verify attempts, single-use via consumedAt. Rate limits are enforced
// from these rows (resend cooldown + per-email hourly cap).
model EmailOtp {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(3)
  requestIp  String?
  createdAt  DateTime @db.Timestamptz(3)  @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("email_otps")
}

// One-time, expiring authorization codes for cross-domain SSO (OAuth-like). Issued
// after a successful Google/passkey login when a relying party (e.g. Live2Dev on a
// different origin) asked to be returned to. The code rides in the redirect URL and is
// exchanged server-to-server — no cookie sharing across sites. Single-use, 60s TTL.
model SsoCode {
  id         String    @id @default(uuid())
  code       String    @unique
  pid        String
  sessionId  String?
  redirectTo String
  clientId   String?
  // PKCE S256 (ANT-284): public clients bind the code to a challenge at
  // issue time; exchange must present the verifier. NULL = no PKCE (legacy
  // confidential-client flow with redirect_uri + client_secret binding).
  codeChallenge       String?
  codeChallengeMethod String?
  consumedAt DateTime? @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3)  @default(now())

  @@index([pid])
  @@map("sso_codes")
}

// Persistent relying-party grants ("App connections"). Written when an SSO
// pid_code is exchanged; revoking stops future code issuance to that origin.
// It cannot end the relying party's own session (standard OAuth limitation).
model SsoGrant {
  id          String    @id @default(uuid())
  pid         String
  origin      String
  clientId    String?
  firstSeenAt DateTime @db.Timestamptz(3)  @default(now())
  lastUsedAt  DateTime @db.Timestamptz(3)  @default(now())
  revokedAt   DateTime? @db.Timestamptz(3)

  @@unique([pid, origin])
  @@map("sso_grants")
}

// Chain registry (admin-managed). Chains and their typed contracts (factory,
// account implementation, …) live here instead of env files so the wallet and
// activation flows render whatever is active — adding a chain is a data row.
// Secrets (relayer keys, RPC API keys) stay in env, never here.
model Chain {
  id           String   @id @default(uuid())
  namespace    String
  reference    String
  name         String
  nativeSymbol String
  decimals     Int      @default(18)
  rpcUrls      String[]
  explorerUrl  String?
  logoUrl      String?
  isTestnet    Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @db.Timestamptz(3) @default(now())
  updatedAt    DateTime @db.Timestamptz(3) @updatedAt

  contracts ChainContract[]
  accounts  ChainAccount[]
  evmRelayerKey EvmRelayerKey?
  deployments TokenDeployment[]

  @@unique([namespace, reference])
  @@map("chains")
}

model ChainContract {
  id           String   @id @default(uuid())
  chainId      String
  chain        Chain    @relation(fields: [chainId], references: [id], onDelete: Cascade)
  type         String
  address      String
  versionLabel String?
  deployTxHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @db.Timestamptz(3) @default(now())
  updatedAt    DateTime @db.Timestamptz(3) @updatedAt

  @@unique([chainId, type])
  @@map("chain_contracts")
}

// Token registry (admin-managed, curated like the chain registry). Token rows
// hold GLOBAL metadata once (symbol/name/logo); per-chain rows live in
// TokenDeployment (mint + decimals differ per chain — e.g. USDT on base, bnb,
// solana). Wallets render only visible deployments, joined with active chains.
// Unknown mints fall back to the short-mint display with no warning.
model Token {
  id         String   @id @default(uuid())
  symbol     String   @unique
  name       String
  logoKey    String?
  createdAt  DateTime @db.Timestamptz(3) @default(now())
  updatedAt  DateTime @db.Timestamptz(3) @updatedAt

  deployments TokenDeployment[]

  @@map("tokens")
}

// One token on one chain (chainId FK → chains.id, so the dashboard picks from
// the chains table and dead chains can never be registered). `isPinned` rows
// render even at zero balance; `isVisible=false` hides instantly. No delete —
// hiding keeps history like chains.
model TokenDeployment {
  id          String   @id @default(uuid())
  tokenId     String
  token       Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  chainId     String
  chain       Chain    @relation(fields: [chainId], references: [id], onDelete: Cascade)
  mint        String
  decimals    Int
  isVisible   Boolean  @default(true)
  isPinned    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @db.Timestamptz(3) @default(now())
  updatedAt   DateTime @db.Timestamptz(3) @updatedAt

  @@unique([tokenId, chainId])
  @@unique([chainId, mint])
  @@map("token_deployments")
}

// EVM auto-deploy relayer key per chain (replaces EVM_RELAYER_SECRET env,
// ANT-193). One row per EVM chain at most; the secret is a 0x-prefixed 32-byte
// hex secp256k1 private key. Writes are admin-only (AdminGuard) and reads stay
// server-side — the key is NEVER exposed via any API response (only a
// hasSecret presence flag). Flagged for ANT-195 security review.
model EvmRelayerKey {
  id        String   @id @default(uuid())
  chainId   String   @unique
  chain     Chain    @relation(fields: [chainId], references: [id], onDelete: Cascade)
  secret    String
  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  @@map("evm_relayer_keys")
}

// Chain fee policy v2 (ANT-730, spec ANT-727 §4). Quote-time source of truth
// for `serviceFee = max(networkFee × bps / 10_000, MIN_FEE[chain])`.
// Versioned rows: exactly one row is active; a new policy ships as a NEW
// version row — never mutate a published row (same rule as FiatFeePolicy and
// the frozen in-code FEE_POLICY_TABLE in common/solana-relay.ts, which stays
// as the DB-unavailable fallback). On-chain immutable values are the
// settlement guard: DB minima must be >= the per-chain settlement floors
// (common/chain-fee-floors.ts, spec §4.3) or admin writes are rejected.
// Dashboard-managed via the admin fee-policy endpoints; every write emits a
// security event (who/when/old-new) and invalidates the 30s policy cache.
model ChainFeePolicy {
  version   Int       @id
  bps       Int       @default(5000)
  active    Boolean   @default(false)
  // FX display source for wallet rendering (spec §4.5, OQ-1): e.g.
  // "CoinGecko USD/IDR". Settlement is always base units on-chain; the
  // rupiah figure is informational. Code fallback rows use "FALLBACK_STATIC".
  fxSource  String    @default("FALLBACK_STATIC")
  fxAsOf    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @db.Timestamptz(3) @default(now())
  updatedAt DateTime  @db.Timestamptz(3) @updatedAt

  minima ChainMinFee[]

  @@map("chain_fee_policies")
}

// Per-chain MIN_FEE leg of one ChainFeePolicy version, in native base units
// (wei for eip155, lamports for solana). Keyed by the chain registry natural
// key (namespace + reference) — not by chain id — so rows survive registry
// re-seeds. Spec §4.2 seeds: eip155:84532/97 + solana rows; Monad (10143) and
// Arbitrum Sepolia (421614) are 0 (spec §4.4, AC-14).
model ChainMinFee {
  id            String         @id @default(uuid())
  policyVersion Int
  policy        ChainFeePolicy @relation(fields: [policyVersion], references: [version], onDelete: Cascade)
  namespace     String
  reference     String
  minFee        BigInt
  createdAt     DateTime @db.Timestamptz(3) @default(now())

  @@unique([policyVersion, namespace, reference])
  @@index([namespace, reference])
  @@map("chain_min_fees")
}

// Relayer subsidy ledger (ANT-730, spec §5.4/NFR-4, OQ-3). One row per
// activation capturing quotedFee vs actualCost (execution gas + L1 data fee
// where the oracle exists). subsidy = actual − quoted (negative = surplus).
// Zero activations without a quote–actual pair is a violation (AC-13); the
// daily aggregate feeds the internal dashboard (admin subsidy summary).
model RelayerSubsidyLedger {
  id         String   @id @default(uuid())
  pid        String
  namespace  String
  reference  String
  // activation | withdraw | execute
  kind       String
  quotedFee  BigInt
  actualCost BigInt
  subsidy    BigInt
  txHash     String?
  createdAt  DateTime @db.Timestamptz(3) @default(now())

  @@index([pid])
  @@index([namespace, reference])
  @@index([createdAt])
  @@map("relayer_subsidy_ledger")
}

// DOKU Sub-Account V2 mapping (1 PID → 1 Sub-Account). DOKU is the
// authoritative ledger — these rows store identity mapping, provider status,
// cached reads, transaction references and fee snapshots only.
// Local `lastBalance` is a read cache, never a ledger.
model FiatProviderAccount {
  id                 String    @id @default(uuid())
  pid                String
  identity           Identity  @relation(fields: [pid], references: [pid], onDelete: Cascade)
  provider           String    @default("doku-sub-account")
  // V2 profileId (1 PID → 1 Sub-Account). */
  profileId          String?   @unique
  /**
   * IDR cash account number (DOKU_MERCHANT_IDR, withdrawable).
   */
  providerAccountId  String?
  /**
   * All V2 accounts [{type, currency, accountNo}] incl. pending/points.
   */
  accounts           Json?
  /**
   * Static BRI VA for deposits (when DOKU returns it).
   */
  vaNumber           String?
  /**
   * POINT account number (DOKU_MERCHANT_POINT, spendable ledger).
   */
  pointAccountId     String?
  /**
   * Contact snapshot from registration (no OTP lifecycle in V2).
   */
  phoneNo            String?
  email              String?
  accountStatus      String    @default("creating")
  currency           String    @default("IDR")
  lastBalance        String?
  lastBalanceAt      DateTime? @db.Timestamptz(3)
  registerRef        String?   @unique
  providerResponse   Json?
  createdAt          DateTime @db.Timestamptz(3)  @default(now())
  updatedAt          DateTime @db.Timestamptz(3)  @updatedAt

  @@unique([pid, provider])
  @@index([providerAccountId])
  @@map("fiat_provider_accounts")
}

model FiatProviderTransaction {
  id                    String   @id @default(uuid())
  pid                   String
  identity              Identity @relation(fields: [pid], references: [pid], onDelete: Cascade)
  accountId             String?
  kind                  String
  providerRef           String   @unique
  providerStatus        String   @default("created")
  /**
   * Payment truth for deposit rows, tracked SEPARATELY from settlement:
   * pending | success | expired | failed | refunded.
   * Checkout SUCCESS writes success here and may trigger POINT issuance.
   * Sub-Account settlement rows NEVER write here — they update
   * settlementStatus only. Legacy rows predate this column: fall back to
   * providerStatus ("success"/"settled" both read as confirmed for
   * non-Checkout history).
   */
  providerPaymentStatus String?
  /**
   * Gross movement amount, whole IDR. Checkout deposits: what the customer
   * paid (net + fee). Internal transfers: the requested amount, GROSS-in
   * (beneficiary receives gross − fee).
   */
  amountIdr             BigInt
  currency              String   @default("IDR")
  /**
   * Platform service fee quote, snapshotted at intent time. DOKU settles
   * fees natively (NET → user + FEE → Treasury) — the API never moves them.
   * Legacy `kind = fee` rows remain for history only.
   */
  feeIdr                BigInt?
  /**
   * Net effect on the user, whole IDR (gross − fee once known).
   */
  netIdr                BigInt?
  feePolicyVersion      Int?
  counterparty          Json?
  providerResponse      Json?
  /**
   * DOKU ledger operation for this movement, if any (Unified Ledger).
   * partnerReferenceNo of the DOKU_NON_FIAT top-up / POINT P2P / POINT
   * debit — the idempotency key at DOKU. Null when no ledger movement
   * was (or will be) issued for this row. Unique when set (DB-level,
   * ANT-254): one ledger movement = one row. NULLs are exempt (Postgres
   * allows multiple NULLs in a UNIQUE index). Pre-deploy check on shared
   * DBs: SELECT "ledgerRef", COUNT(*) ... HAVING COUNT(*) > 1 must be empty.
   */
  ledgerRef             String?   @unique
  /**
   * Ledger credit status, tracked SEPARATELY from payment status:
   * pending | issued | failed | blocked | clawed_back.
   */
  ledgerStatus          String?
  /**
   * Fiat settlement/backing status, tracked SEPARATELY from payment/ledger:
   * pending | settled | failed. Settlement is a backing/reconciliation
   * event only — it NEVER gates POINT issuance and NEVER means payment
   * confirmed. Written only from SETTLEMENT-family history rows.
   */
  settlementStatus      String?
  /**
   * Double-entry direction of this row relative to `pid` (immutable
   * journal): in = credit to pid, out = debit from pid. Fiat-intent rows
   * (deposit parents) carry null — they move no PTS.
   */
  direction             String?
  /**
   * DOKU account number debited by this movement (audit/source leg).
   */
  sourceAccount         String?
  /**
   * DOKU account number credited by this movement (audit/dest leg).
   */
  destAccount           String?
  /**
   * Groups the legs of one logical movement (e.g. a P2P transfer's
   * sender-out + recipient-in + treasury-fee legs).
   */
  entryGroup            String?
  /**
   * Deterministic replay order (autoincrement — never reuse createdAt).
   * Replay folds rows in replaySeq order.
   */
  replaySeq             BigInt?  @default(autoincrement())
  /**
   * True once PTS units are permanently extinguished (redemption burn).
   * Extinguished rows never count toward outstanding, forever.
   */
  extinguished          Boolean  @default(false)
  createdAt             DateTime @db.Timestamptz(3) @default(now())
  updatedAt             DateTime @db.Timestamptz(3) @updatedAt

  @@index([pid])
  @@index([accountId])
  @@index([pid, kind, providerStatus])
  @@map("fiat_provider_transactions")
}

// Webhook inbox: every DOKU push is persisted BEFORE processing.
// `externalId` (DOKU X-EXTERNAL-ID, unique per notification) is the replay key.
model FiatWebhookEvent {
  id         String   @id @default(uuid())
  provider   String   @default("doku-sub-account")
  externalId String   @unique
  eventType  String
  payload    Json
  status     String   @default("received")
  createdAt  DateTime @db.Timestamptz(3) @default(now())

  @@map("fiat_webhook_events")
}

// Versioned platform service-fee policy. Exactly one row is active; every
// money movement snapshots {feeIdr, netIdr, feePolicyVersion} at intent time
// so policy changes never rewrite history.
// fee = clamp(round-half-up(amount * percentBps / 10_000), minIdr, maxIdr).
// Flat 5% clamped to [Rp5.000, Rp25.000] by default; 0 = unbounded on either
// side. This is the PeridotID fee ONLY — DOKU charges its own fee separately.
// Checkout top-ups additionally enforce a Rp50.000 NET minimum in API code
// (no DOKU-side minimum). Internal transfers stay GROSS-in.
// Settlement is DOKU-native per payment (static PERCENTAGE split rule).
model FiatFeePolicy {
  version    Int      @id
  percentBps Int      @default(500)
  minIdr     BigInt   @default(0)
  maxIdr     BigInt   @default(25000)
  /** PPN (VAT) on the PeridotID fee, basis points (1100 = 11%). */
  taxBps     Int      @default(1100)
  active     Boolean  @default(false)
  createdAt  DateTime @db.Timestamptz(3) @default(now())

  @@map("fiat_fee_policies")
}

// Singleton config for the DOKU payment-gateway PPN (VAT), applied to every
// method's gateway fee. One rate for all methods (DOKU taxes its fee uniformly).
model FiatTaxSetting {
  id         Int      @id @default(1)
  dokuTaxBps Int      @default(1100)
  updatedAt  DateTime @db.Timestamptz(3) @updatedAt

  @@map("fiat_tax_settings")
}

// Fiat ledger — the spendable balance, statement and send/receive. This is
// the ONLY balance rail: DOKU Checkout is money-in only (no Sub-Account).
// Immutable double-entry journal: one logical movement = one entryGroup,
// written atomically. Only `posted` rows count in replay
// (apps/api/src/fiat/fiat-ledger-replay.ts). Rows are never deleted.
model FiatLedgerEntry {
  id               String   @id @default(uuid())
  entryGroup       String
  kind             String
  pid              String
  identity         Identity @relation(fields: [pid], references: [pid], onDelete: Restrict)
  counterpartyPid  String?
  amountIdr        BigInt
  direction        String
  idempotencyKey   String   @unique
  parentRef        String?
  status           String   @default("created")
  feePolicyVersion Int?
  counterparty     Json?
  source           String?
  replaySeq        BigInt?  @default(autoincrement())
  /** Tamper-evident chain (posted rows only). `hash` = sha256(canonical row +
   *  prevHash); `hashSeq` is the chain position, assigned at post time in the
   *  ledger write lock. See apps/api/src/fiat/fiat-ledger-hash.ts. */
  prevHash         String?
  hash             String?
  hashSeq          BigInt?
  createdAt        DateTime @db.Timestamptz(3) @default(now())

  @@index([pid])
  @@index([entryGroup])
  @@index([pid, status])
  @@index([hashSeq])
  @@map("fiat_ledger_entries")
}

// Outbox for third-party callbacks (Live2Dev escrow etc.). Written in the same
// transaction as the ledger movement (atomic outbox, ANT-254); delivered
// asynchronously with HMAC and retries by the admin dispatch endpoint.
// See docs/FIAT_LEDGER.md. `idempotencyKey` dedups the enqueue
// (`<entryGroup>:<targetPid>`): a retried confirm can never fork a second
// callback for the same movement. NULL only on pre-ANT-254 rows.
model FiatLedgerEvent {
  id            String    @id @default(uuid())
  eventType     String
  idempotencyKey String?  @unique
  /** Owner PID of the target PidApp (the escrow/recipient app). */
  targetPid     String
  targetUrl     String
  payload       Json
  /** pending | delivered | failed */
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime @db.Timestamptz(3)  @default(now())
  lastError     String?
  createdAt     DateTime @db.Timestamptz(3)  @default(now())
  deliveredAt   DateTime? @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("fiat_ledger_events")
}

// Registered third-party apps ("Sign in with PeridotID"). Any developer registers an
// app, gets a public client_id, and manages the allowed origins its users may be
// returned to (the exact return URL is passed in code at login time). The same list
// gates browser API calls (CORS).
model PidApp {
  id                    String    @id @default(uuid())
  clientId              String    @unique
  ownerPid              String
  owner                 Identity  @relation(fields: [ownerPid], references: [pid], onDelete: Cascade)
  name                  String
  allowedOrigins        String[]
  isActive              Boolean   @default(true)
  // Verified partner (admin-only): the global PeridotID fiat fee is waived
  // for movements in this app's context. The app's own stacked fee, DOKU
  // provider fees, and on-chain fees still apply. See docs/RP_SESSIONS.md.
  isVerified            Boolean   @default(false)
  // Optional backend secret (confidential clients). SHA-256 hex (peppered when
  // PID_APP_SECRET_PEPPER is set — see PidAppsService), never plaintext.
  // When set, code exchange requires the matching secret.
  clientSecretHash      String?
  clientSecretPrefix    String?
  clientSecretCreatedAt DateTime? @db.Timestamptz(3)
  // Rotation deadline: exchanges/token requests past this fail closed until
  // the owner rotates (ANT-227 item 5). Pre-policy NULL rows were backfilled
  // by 20261022_app_secret_expiry_backfill (ANT-233 F2); NULL now means
  // "no secret set" (public client), never "immortal secret".
  clientSecretExpiresAt DateTime? @db.Timestamptz(3)
  // Previous-hash grace window (ANT-283): rotation moves the replaced hash
  // here with a short overlap deadline (APP_CLIENT_SECRET_GRACE). Both hashes
  // verify until the previous deadline passes, then it is ignored. NULL =
  // no previous secret (never rotated, or grace already superseded).
  prevClientSecretHash      String?
  prevClientSecretExpiresAt DateTime? @db.Timestamptz(3)
  // Per-app callback endpoint + HMAC signing secret (set together). The
  // ledger posts signed events here (X-Pid-Signature). See docs/FIAT_LEDGER.md.
  webhookUrl            String?
  webhookSecret         String?
  // XP & Leveling (ANT-89 M1): per-app XP permission. Verification alone
  // grants nothing — event intake (M3) requires isVerified AND xpEnabled AND
  // an approved event type. Admin-only writes (Role.admin); dev self-approval
  // is impossible. Read API is open to all authorized apps incl. unverified.
  xpEnabled           Boolean  @default(false)
  approvedEventTypes  String[] @default([])
  createdAt             DateTime @db.Timestamptz(3)  @default(now())
  updatedAt             DateTime @db.Timestamptz(3)  @updatedAt

  fees PidAppFee[]
  xpQuota XpQuota?
  scopedTasks XpTask[]

  @@index([ownerPid])
  @@map("pid_apps")
}

// Per-app fee schedule (stacks on top of the global PeridotID fee). Charged
// only when the movement is initiated in this app's context (model A); the fee
// credits the app's own account (ownerPid). One row per operation.
model PidAppFee {
  id         String   @id @default(uuid())
  appId      String
  app        PidApp   @relation(fields: [appId], references: [id], onDelete: Cascade)
  /** topup | transaction | withdraw */
  operation  String
  percentBps Int      @default(0)
  minIdr     BigInt   @default(0)
  maxIdr     BigInt   @default(0)
  enabled    Boolean  @default(false)
  createdAt  DateTime @db.Timestamptz(3) @default(now())
  updatedAt  DateTime @db.Timestamptz(3) @updatedAt

  @@unique([appId, operation])
  @@map("pid_app_fees")
}

// Payment-gateway (DOKU) fee schedule for top-ups, keyed by DOKU payment
// method. `methodKey` is an exact DOKU `payment_method_types` code, a category
// ("VIRTUAL_ACCOUNT" | "EWALLET" | "CARD" | "QRIS" | "OTHER"), or "*" (default).
// Resolution: exact code → category → "*". 0 min/max = unbounded. Admin-edited;
// this is the fallback when DOKU exposes no real-time fee. See
// apps/api/src/fiat/payment-fee.service.ts.
model PaymentGatewayFeeRate {
  id         String   @id @default(uuid())
  methodKey  String   @unique
  percentBps Int      @default(0)
  flatIdr    BigInt   @default(0)
  minIdr     BigInt   @default(0)
  maxIdr     BigInt   @default(0)
  enabled    Boolean  @default(true)
  createdAt  DateTime @db.Timestamptz(3) @default(now())
  updatedAt  DateTime @db.Timestamptz(3) @updatedAt

  @@map("payment_gateway_fee_rates")
}

// Singleton lock serializing the first-admin bootstrap race (ANT-233 F4).
// At most one row ever exists (PK on the fixed id 'bootstrap-admin', enforced
// by CHECK). The winning bootstrap claim inserts it in the same transaction
// that creates the admin identity; a concurrent loser gets P2002 and claims as
// a plain user. Promoted admins (SQL/admin:promote) never touch this table.
model BootstrapAdminLock {
  id        String   @id
  pid       String
  createdAt DateTime @db.Timestamptz(3) @default(now())

  @@map("bootstrap_admin_locks")
}

// ---------------------------------------------------------------------------
// XP & Leveling (ANT-89 M1). Centralized PeridotID authority: PeridotID alone
// awards XP (M3 intake), all authorized apps read Level. The XP journal is
// independent of the financial ledger. All Timestamptz(3) (ANT-317).
//
// Invariants (see plan rev 4, R1/R2/R4):
// - Ledger XP totals are NEVER rewritten — only the level mapping changes
//   across policy versions (UserXpState.policyVersionId stamps the computer).
// - XpTaskCompletion uniqueness is composite (appId, eventId) (ANT-430 C1;
//   plan rev 5 §13 supersedes rev-4 R1): no unique on (taskId,pid,periodKey);
//   one-time tasks use partial unique indexes declared in raw SQL in the M1
//   migration (Prisma cannot express them).
// - Exactly one active policy version (partial unique index in migration).
// ---------------------------------------------------------------------------

model XpPolicyVersion {
  id           String    @id @default(uuid())
  version      Int       @unique
  // { base: 100, exponent: 1.5, rounding: "floor" } — default formula
  // xpToAdvance(L) = floor(base * L^exponent). R5 locks this as default.
  formula      Json
  // Nullable: NULL = uncapped. Default 100.
  maxLevel     Int?      @default(100)
  createdBy    String
  createdAt    DateTime  @db.Timestamptz(3) @default(now())
  activatedAt  DateTime? @db.Timestamptz(3)
  supersededAt DateTime? @db.Timestamptz(3)

  thresholds XpLevelThreshold[]
  states     UserXpState[]
  entries    XpLedgerEntry[]

  @@map("xp_policy_versions")
}

model XpLevelThreshold {
  policyVersionId String
  policy          XpPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  // Level this cumulative XP attains (level 1 starts at 0).
  level           Int
  cumulativeXp    BigInt

  @@id([policyVersionId, level])
  @@map("xp_level_thresholds")
}

model UserXpState {
  // One row per PID; backfilled lazily on first read (genesis L1 / 0 XP).
  pid             String          @id
  identity        Identity        @relation(fields: [pid], references: [pid], onDelete: Cascade)
  totalXp         BigInt          @default(0)
  level           Int             @default(1)
  policyVersionId String
  policy          XpPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  updatedAt       DateTime        @db.Timestamptz(3) @updatedAt

  @@map("user_xp_states")
}

model XpTask {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?
  xpReward    Int
  // once | daily | weekly | monthly | unlimited
  recurring   String  @default("once")
  lifetimeLimit Int?
  dailyLimit    Int?
  weeklyLimit   Int?
  monthlyLimit  Int?
  cooldownSecs  Int?
  availableFrom  DateTime? @db.Timestamptz(3)
  availableUntil DateTime? @db.Timestamptz(3)
  // draft | active | disabled | archived
  status      String  @default("draft")
  // Verification checker (R3): internal_state (PeridotID-observed rows) or
  // backend_check (validated against PeridotID-owned records). Tasks without
  // a reliable checker cannot be activated (enforced in admin API, M2).
  verificationType    String  @default("internal_state")
  verificationChecker String?
  // NULL = ecosystem-wide; otherwise scoped to one app.
  scopeAppId  String?
  scopeApp    PidApp? @relation(fields: [scopeAppId], references: [id], onDelete: SetNull)
  createdBy   String
  createdAt   DateTime @db.Timestamptz(3) @default(now())
  updatedAt   DateTime @db.Timestamptz(3) @updatedAt

  completions XpTaskCompletion[]
  ledgerEntries XpLedgerEntry[]

  @@index([status])
  @@index([scopeAppId])
  @@map("xp_tasks")
}

model XpTaskCompletion {
  id             String   @id @default(uuid())
  pid            String
  identity       Identity @relation(fields: [pid], references: [pid], onDelete: Cascade)
  taskId         String
  task           XpTask   @relation(fields: [taskId], references: [id], onDelete: Restrict)
  // Accounting window label (e.g. "2026-10-22" / "2026-W43"), NOT a
  // uniqueness key — repeatable tasks keep many valid completions per period
  // up to configured caps (enforced by COUNT in the award transaction, R1).
  periodKey      String
  // Idempotency key, scoped per app (ANT-430 C1 / plan rev 5 §13):
  // composite @@unique([appId, eventId]) — two apps may independently use
  // the same event_id; only same-app + same-event_id is a duplicate.
  // Denormalized once-flag + resource id for the partial one-time unique
  // indexes declared in raw SQL in the M1 migration:
  //   (taskId, pid) WHERE isOnce AND resourceId IS NULL
  //   (taskId, pid, resourceId) WHERE isOnce AND resourceId IS NOT NULL
  appId          String   @default("")
  eventId        String
  isOnce         Boolean  @default(false)
  resourceId     String?
  awardedEntryId String?  @unique
  awardedEntry   XpLedgerEntry? @relation("CompletionAward", fields: [awardedEntryId], references: [id], onDelete: SetNull)
  createdAt      DateTime @db.Timestamptz(3) @default(now())

  @@unique([appId, eventId])
  @@index([pid])
  @@index([taskId, pid])
  @@map("xp_task_completions")
}

model XpLedgerEntry {
  id            String   @id @default(uuid())
  pid           String
  identity      Identity @relation(fields: [pid], references: [pid], onDelete: Cascade)
  deltaXp       BigInt
  balanceAfter  BigInt
  levelAfter    Int
  // task_award | manual_adjustment | reversal
  kind          String
  taskId        String?
  task          XpTask?  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  // Per-app idempotency key (informational here; enforced unique as the
  // composite (appId, eventId) on XpTaskCompletion).
  eventId       String?
  appId         String?
  reason        String?
  actorAdminId  String?
  policyVersionId String
  policy          XpPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  createdAt     DateTime @db.Timestamptz(3) @default(now())

  completion XpTaskCompletion? @relation("CompletionAward")

  @@index([pid, createdAt])
  @@index([eventId])
  @@map("xp_ledger_entries")
}

// Per-app award caps (M3 enforcement; admin-configured, never hardcoded).
model XpQuota {
  appId         String  // FK to PidApp.id; also the PK (one row per app).
  app           PidApp  @relation(fields: [appId], references: [id], onDelete: Cascade)
  dailyCap      Int?
  weeklyCap     Int?
  monthlyCap    Int?
  suspended     Boolean @default(false)
  suspendReason String?
  updatedAt     DateTime @db.Timestamptz(3) @updatedAt

  @@id([appId])
  @@map("xp_quotas")
}

// Organization-level cap: aggregate across all apps of one developer org,
// keyed by PidApp.ownerPid (R2 lock order: state → quota → org quota).
model XpOrgQuota {
  ownerPid    String   // FK to Identity.pid (the app owner's PID); also the PK.
  owner       Identity @relation(fields: [ownerPid], references: [pid], onDelete: Cascade)
  dailyCap    Int?
  weeklyCap   Int?
  monthlyCap  Int?
  updatedAt   DateTime @db.Timestamptz(3) @updatedAt

  @@id([ownerPid])
  @@map("xp_org_quotas")
}

model XpSuspiciousActivity {
  id        String   @id @default(uuid())
  pid       String?
  identity  Identity? @relation(fields: [pid], references: [pid], onDelete: SetNull)
  appId     String?
  signal    String
  detail    Json?
  reviewed  Boolean  @default(false)
  createdAt DateTime @db.Timestamptz(3) @default(now())

  @@index([reviewed, createdAt])
  @@map("xp_suspicious_activities")
}

// ANT-456 — DB-driven configuration (SystemSetting table, plan §3.1).
// One table for all future features: namespaced keys
// (`<domain>.<area>.<field>`), JSONB values with a declared valueType,
// optimistic locking via `version`. Every write appends a SecurityEvent
// row (+ a SystemSettingHistory row for the diff view) in the same
// transaction — reads never bypass the audit on the write path.
model SystemSetting {
  key         String   @id
  value       Json
  valueType   String
  description String?
  updatedBy   String
  version     Int      @default(1)
  updatedAt   DateTime @db.Timestamptz(3) @updatedAt

  @@map("system_settings")
}

// ANT-456 — per-write history for the admin diff view (spec §7 A2).
// Append-only; written in the same transaction as the setting update.
model SystemSettingHistory {
  id        String   @id @default(uuid())
  key       String
  oldValue  Json?
  newValue  Json
  reason    String
  version   Int
  updatedBy String
  createdAt DateTime @db.Timestamptz(3) @default(now())

  @@index([key, createdAt])
  @@map("system_setting_history")
}

// ANT-456 — auditable backfill-run procedure (plan §3.5), replacing the
// permanent PID_XP_MIGRATION_ENABLED env var. One row per requested run
// (preview or execution): resumable via `cursor`, idempotent page
// execution, run history is the audit trail (plus SecurityEvent rows).
model BackfillRun {
  id            String    @id @default(uuid())
  policyId      String
  policyVersion Int
  status        String    @default("queued")
  cursor        String?
  dryRun        Boolean   @default(true)
  processed     Int       @default(0)
  updated       Int       @default(0)
  actor         String
  startedAt     DateTime  @db.Timestamptz(3) @default(now())
  finishedAt    DateTime? @db.Timestamptz(3)

  @@index([startedAt])
  @@map("xp_backfill_runs")
}
