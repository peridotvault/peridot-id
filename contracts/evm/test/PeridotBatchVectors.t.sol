pragma solidity ^0.8.20;

import {Test} from "forge-std/Test.sol";
import {MockGame} from "./PeridotBatch.t.sol";

/// @notice Golden-vector parity for the TS SDK batch builders (ANT-763, Tobias follow-up).
/// Vectors generated by `packages/evm` `EvmAdapter.buildBatch*` (see
/// `test/vectors/batch-golden.json`); this test proves, on-chain and in CI:
/// (a) TS `opsHash` == `keccak256(abi.encode(targets, values, datas))`;
/// (b) TS outer calldata decodes with the contract's exact tuple types and
/// all fields round-trip. Full TS→chain execution proof (real signatures)
/// belongs to the anvil e2e extension, which runs the same builders.
contract PeridotBatchVectorsTest is Test {
    bytes32 constant MODE_BATCH = bytes32(uint256(0x01) << 248);
    address constant GAME = 0x5991A2dF15A8F6A256D3Ec51E99254Cd3fb576A9;
    address constant FEE_RECIPIENT = 0x7777777777777777777777777777777777777777;
    uint64 constant DEADLINE = 1_000_300;
    uint16 constant POLICY_V1 = 1;
    uint256 constant MAX_FEE = 0.0015 ether;
    uint256 constant NET_FEE = 0.001 ether;

    function _fill(uint256 n, bytes1 b) internal pure returns (bytes memory out) {
        out = new bytes(n);
        for (uint256 i = 0; i < n; i++) out[i] = b;
    }

    struct Fx {
        address[] t;
        uint256[] v;
        bytes[] d;
        bytes auth;
        bytes client;
        bytes32 r;
        bytes32 s;
        bytes32 pid;
    }

    function _fx() internal returns (Fx memory f) {
        f.t = new address[](2);
        f.t[0] = GAME;
        f.t[1] = GAME;
        f.v = new uint256[](2);
        f.d = new bytes[](2);
        f.d[0] = abi.encodeCall(MockGame.recordScore, (7));
        f.d[1] = abi.encodeCall(MockGame.recordScore, (8));
        f.auth = _fill(40, 0xab);
        f.client = _fill(20, 0xcd);
        f.r = bytes32(uint256(1));
        f.s = bytes32(uint256(2));
        f.pid = bytes32(uint256(7));
    }

    function _stripSelector(bytes memory outer) internal pure returns (bytes memory body) {
        body = new bytes(outer.length - 4);
        for (uint256 i = 0; i < body.length; i++) body[i] = outer[i + 4];
    }

    function test_VectorOpsHashParity() public {
        string memory json = vm.readFile("test/vectors/batch-golden.json");
        bytes32 tsOpsHash = abi.decode(vm.parseJson(json, ".opsHash"), (bytes32));
        Fx memory f = _fx();
        assertEq(keccak256(abi.encode(f.t, f.v, f.d)), tsOpsHash);
    }

    function test_VectorOwnerCalldataDecodes() public {
        string memory json = vm.readFile("test/vectors/batch-golden.json");
        bytes memory outer = abi.decode(vm.parseJson(json, ".ownerCalldata"), (bytes));
        assertEq(bytes4(outer), bytes4(keccak256("executeV4(bytes32,bytes)")));
        (bytes32 mode, bytes memory inner) = abi.decode(_stripSelector(outer), (bytes32, bytes));
        assertEq(mode, MODE_BATCH);
        _checkOwnerInner(inner);
    }

    function _checkOwnerInner(bytes memory inner) internal {
        (
            address[] memory t,
            uint256[] memory v,
            bytes[] memory d,
            uint64 deadline,
            uint16 policy,
            uint256 maxFee,
            uint256 netFee,
            bytes memory auth,
            bytes memory client,
            bytes32 r,
            bytes32 s
        ) = abi.decode(
            inner, (address[], uint256[], bytes[], uint64, uint16, uint256, uint256, bytes, bytes, bytes32, bytes32)
        );
        Fx memory f = _fx();
        assertEq(t, f.t);
        assertEq(v, f.v);
        assertEq(keccak256(d[0]), keccak256(f.d[0]));
        assertEq(keccak256(d[1]), keccak256(f.d[1]));
        assertEq(deadline, DEADLINE);
        assertEq(policy, POLICY_V1);
        assertEq(maxFee, MAX_FEE);
        assertEq(netFee, NET_FEE);
        assertEq(keccak256(auth), keccak256(f.auth));
        assertEq(keccak256(client), keccak256(f.client));
        assertEq(r, f.r);
        assertEq(s, f.s);
    }

    function test_VectorSessionCalldataDecodes() public {
        string memory json = vm.readFile("test/vectors/batch-golden.json");
        bytes memory outer = abi.decode(vm.parseJson(json, ".sessCalldata"), (bytes));
        assertEq(bytes4(outer), bytes4(keccak256("executeFromExecutorV2(bytes32,bytes)")));
        (bytes32 mode, bytes memory inner) = abi.decode(_stripSelector(outer), (bytes32, bytes));
        assertEq(mode, MODE_BATCH);
        _checkSessionInner(inner);
    }

    function _checkSessionInner(bytes memory inner) internal {
        (
            bytes32 pid,
            address[] memory t,
            uint256[] memory v,
            bytes[] memory d,
            uint64 deadline,
            uint64 seq,
            uint16 policy,
            uint256 maxFee,
            uint256 netFee,
            address feeRecipient,
            bytes memory auth,
            bytes memory client,
            bytes32 r,
            bytes32 s
        ) = abi.decode(
            inner,
            (bytes32, address[], uint256[], bytes[], uint64, uint64, uint16, uint256, uint256, address, bytes, bytes, bytes32, bytes32)
        );
        Fx memory f = _fx();
        assertEq(pid, f.pid);
        assertEq(t, f.t);
        assertEq(v, f.v);
        assertEq(keccak256(d[0]), keccak256(f.d[0]));
        assertEq(keccak256(d[1]), keccak256(f.d[1]));
        assertEq(deadline, DEADLINE);
        assertEq(seq, 0);
        assertEq(policy, POLICY_V1);
        assertEq(maxFee, MAX_FEE);
        assertEq(netFee, NET_FEE);
        assertEq(feeRecipient, FEE_RECIPIENT);
        assertEq(keccak256(auth), keccak256(f.auth));
        assertEq(keccak256(client), keccak256(f.client));
        assertEq(r, f.r);
        assertEq(s, f.s);
    }
}
