# deployer 
DEPLOYER_EVM_PRIVATE_KEY="0xYOUR_DEPLOYER_PRIVATE_KEY_HERE"
DEPLOYER_SVM_SECRET_KEY="[YOUR_64_BYTE_ARRAY]"

# relayer
# NOTE: RELAYER_SVM_SECRET_KEY format is per-consumer, not interchangeable:
# - API/Solana side expects 64-byte hex (opt 0x) or JSON 64-byte array.
# - ac712/Stellar side (contracts/stellar/account/scripts/ac712/run.mjs) expects S... strkey.
# One Infisical value cannot serve both; store per-consumer values.
RELAYER_EVM_PRIVATE_KEY="0xYOUR_DEPLOYER_PRIVATE_KEY_HERE"
RELAYER_SVM_SECRET_KEY="[YOUR_64_BYTE_ARRAY]"