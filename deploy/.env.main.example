# PeridotID deploy env - main (production).
# Copy to deploy/.env.main and fill in. Never commit the filled copy.

# main: empty. test: "sandbox." and "-test" (see compose).
ENV_SUFFIX=
NAMESPACE=

# Workspace environment badge + cross-env link (baked into the web build).
PID_ENV=production
PID_OTHER_WORKSPACE_URL=https://sandbox.pid.peridotvault.com/workspace
# Optional: client_id used by the /workspace/demo sample.
# PID_DEMO_CLIENT_ID=

# --- domains ---
# web at pid.peridotvault.com, app at app.pid.peridotvault.com, API at api.pid.peridotvault.com
# (all fixed in compose.yaml). CLIENT_SUCCESS_URL lands the Google OAuth redirect on the app.
CLIENT_SUCCESS_URL=https://app.pid.peridotvault.com
EXPO_PUBLIC_API_URL=https://api.pid.peridotvault.com
CORS_ORIGINS=https://app.pid.peridotvault.com,https://pid.peridotvault.com,http://localhost:8081
# ^ localhost:8081 lets the dev wallet (Expo web) call the prod API with credentials
# (Google login path — the shared OAuth client registers only the prod callback).
COOKIE_DOMAIN=.peridotvault.com
# Cross-origin SSO returnTo allowlist (comma-separated origins, e.g. relying parties)
CLIENT_REDIRECT_ALLOWLIST=https://live2dev.com,https://pro.live2dev.com,https://admin.live2dev.com

# --- runtime / auth ---
NODE_ENV=production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars

# Google OAuth — one shared client for dev and prod (id/secret identical); only the
# callback differs. This deploy env pins the prod callback; local dev pins its own.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.pid.peridotvault.com/v1/auth/google/callback
COOKIE_SAMESITE=lax

# NOTE: PORT (3301) and COOKIE_SECURE (true) are pinned in compose.yaml, not tunable here.

# --- WebAuthn ---
# RP_ID stays on the parent domain (pid.peridotvault.com) so passkeys registered while the
# app lived there keep working on app.pid.peridotvault.com (a subdomain of the RP ID).
WEBAUTHN_RP_ID=pid.peridotvault.com
WEBAUTHN_RP_NAME=PeridotID
WEBAUTHN_ORIGINS=https://app.pid.peridotvault.com,https://api.pid.peridotvault.com

# --- shared infra Postgres (create first: ./deploy/db-init.sh main) ---
# On self-hosted Postgres DATABASE_URL is the only connection string (no pooler,
# so no DIRECT_URL — the schema reads DATABASE_URL alone).
DATABASE_URL=postgresql://peridot_id:CHANGE_ME@postgres:5432/peridot_id

# --- Solana ---
# devnet for now; prod box hosts devnet/mainnet later via network env.
SOLANA_NETWORK=devnet
PID_PROGRAM_ID=CiwLJ1hMNjSRdZj2yMVt9BseRTjVd4pjz7Mxr9yXf6NT
PID_SOLANA_RPC_URL=https://api.devnet.solana.com
# Peridot relayer (floats fee + rent; must hold SOL on the target network).
PID_RELAYER_SECRET=CHANGE_ME_64_byte_hex
# Retired in V3 (no margin on quotes).
# PID_ACTIVATION_MARGIN_RATE=0.5
PID_ACTIVATION_POLL_MS=10000
PID_ACTIVATION_CONFIRM_ATTEMPTS=15
PID_ACTIVATION_CONFIRM_INTERVAL_MS=1000
PID_TREASURY_PUBKEY=CHANGE_ME
# Fee-policy version (V1 = 1 = fixed 50% protocol fee, enforced on-chain).
PID_FEE_POLICY_VERSION=1

# --- Fiat: DOKU Checkout (money-in only) + internal fiat ledger ---
# No Sub-Account: Checkout payments land on the merchant account; every user
# balance lives on the internal fiat ledger (docs/FIAT_LEDGER.md).
DOKU_MODE=production
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# RSA PEM for legacy Sub-Account calls — not required for Checkout-only.
DOKU_PRIVATE_KEY=
# Legacy Sub-Account hierarchy (frozen; kept for the DOKU Unified Ledger docs).
# DOKU_USERS_PARENT_PROFILE_ID=
# DOKU_TREASURY_PROFILE_ID=
# DOKU_TREASURY_ACCOUNT_NO=
# DOKU_SYSTEM_POINT_ACCOUNT_NO=
# DOKU_TREASURY_POINT_ACCOUNT_NO=
# Bank withdrawals (redemption) — disabled for now.
PID_REDEMPTION_ENABLED=false
# PID_REDEMPTION_RESERVE_IDR=0
# Internal fiat ledger (default enabled; freeze blocks new issues/sends).
# PID_FIAT_LEDGER_ENABLED=true
# PID_FIAT_LEDGER_FROZEN=false
# PID_FIAT_LEDGER_TREASURY_PID=
# Machine (client-credentials) token TTL for app backends.
# APP_TOKEN_TTL=1h
# DOKU payment notifications → the API webhook route (no sub-account path).
DOKU_WEBHOOK_URL=https://api.pid.peridotvault.com/v1/fiat/webhook
# DOKU_CHECKOUT_NOTIFY_URL=https://api.pid.peridotvault.com/v1/fiat/webhook

# Admin bootstrap: PIDs that become `admin` when claimed (comma-separated).
# PID_BOOTSTRAP_ADMIN_PID=ifal@pid

# --- EVM: intentionally unwired in prod (testnet/dev-only for now) ---
# To enable: add EVM_FACTORY_ADDRESS, EVM_IMPLEMENTATION_ADDRESS, EVM_RPC_URL_<ref>,
# PID_EVM_POLL_MS to compose.yaml environment alongside the lines below in this file.