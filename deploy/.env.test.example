# PeridotID deploy env - test (staging soak stack).
# Copy to deploy/.env.test and fill in. Never commit the filled copy.
# Usage: ./deploy/up.sh test  (separate compose project: peridot-id-test)
# Staging runs SANDBOX DOKU credentials — real money can never move here.
# Redemption stays disabled until the sandbox matrix + acceptance rows pass.

# test: "test." and "-test" (see compose).
ENV_SUFFIX=test.
NAMESPACE=-test

# --- domains ---
# NOTE: compose.yaml pins production hostnames; point staging DNS / Traefik
# overrides at the infra layer, or run the API on its exposed port directly.
CLIENT_SUCCESS_URL=https://app.pid.peridotvault.com
EXPO_PUBLIC_API_URL=https://api.pid.peridotvault.com
CORS_ORIGINS=https://app.pid.peridotvault.com,https://pid.peridotvault.com,http://localhost:8081
COOKIE_DOMAIN=.peridotvault.com
CLIENT_REDIRECT_ALLOWLIST=https://live2dev.com,https://pro.live2dev.com,https://admin.live2dev.com

# --- runtime / auth ---
NODE_ENV=production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars

# Google OAuth — staging reuses the shared client; confirm the callback works
# for staging-driven logins or restrict staging to non-OAuth flows.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.pid.peridotvault.com/v1/auth/google/callback
COOKIE_SAMESITE=lax

# --- WebAuthn ---
WEBAUTHN_RP_ID=pid.peridotvault.com
WEBAUTHN_RP_NAME=PeridotID
WEBAUTHN_ORIGINS=https://app.pid.peridotvault.com,https://api.pid.peridotvault.com

# --- shared infra Postgres (create first: ./deploy/db-init.sh test) ---
DATABASE_URL=postgresql://peridot_id_test:CHANGE_ME@postgres:5432/peridot_id_test

# --- Solana ---
SOLANA_NETWORK=devnet
PID_PROGRAM_ID=CiwLJ1hMNjSRdZj2yMVt9BseRTjVd4pjz7Mxr9yXf6NT
PID_SOLANA_RPC_URL=https://api.devnet.solana.com
PID_RELAYER_SECRET=CHANGE_ME_64_byte_hex
PID_ACTIVATION_POLL_MS=10000
PID_ACTIVATION_CONFIRM_ATTEMPTS=15
PID_ACTIVATION_CONFIRM_INTERVAL_MS=1000
PID_TREASURY_PUBKEY=CHANGE_ME
PID_FEE_POLICY_VERSION=1

# --- Fiat: DOKU SANDBOX ONLY on staging ---
DOKU_MODE=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PRIVATE_KEY=
DOKU_SAC_TYPE=DEFAULT
# DOKU_USERS_PARENT_PROFILE_ID=
# DOKU_TREASURY_PROFILE_ID=
# DOKU_TREASURY_ACCOUNT_NO=
# DOKU_SYSTEM_POINT_ACCOUNT_NO=
# DOKU_TREASURY_POINT_ACCOUNT_NO=
# Keep disabled until PRD_v6 §8 verification + acceptance rows pass.
PID_REDEMPTION_ENABLED=false
# PID_REDEMPTION_RESERVE_IDR=0
DOKU_WEBHOOK_URL=https://api.pid.peridotvault.com/v1/fiat/sub-accounts/webhook
# DOKU_CHECKOUT_NOTIFY_URL=https://api.pid.peridotvault.com/v1/fiat/sub-accounts/webhook
