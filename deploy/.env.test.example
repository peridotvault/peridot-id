# PeridotID deploy env - test / SANDBOX stack (staging + developer sandbox).
# Copy to deploy/.env.test and fill in. Never commit the filled copy.
# Usage: ./deploy/up.sh test   (separate compose project: peridot-id-test)
#
# This is PeridotID's SANDBOX: DOKU runs in sandbox mode, so real money can
# never move here. Apps (public + internal) test their integrations against it.
# Prod (.env.main) and sandbox are fully separate: DB, DOKU mode, JWT secrets,
# cookie domain, and every app registration (clientId/secret/origins/fees).

# sandbox hostnames: sandbox.peridot.id, sandbox-api.peridot.id, sandbox-dashboard.peridot.id
ENV_SUFFIX=sandbox.
NAMESPACE=-test

# --- domains ---
# ONE service-URL set (ANT-193): CORS, WebAuthn origins, and cookie attributes
# derive from these — no per-env origin list to maintain.
WALLET_URL=https://sandbox.peridot.id
API_URL=https://sandbox-api.peridot.id
DASHBOARD_URL=https://sandbox-dashboard.peridot.id
DOCS_URL=https://docs.peridot.id
VITE_API_URL=https://sandbox-api.peridot.id
# Dashboard build args (baked into the image at build time — ANT-694). The
# sandbox dashboard MUST carry these: Dockerfile.dashboard falls back to the
# PRODUCTION hosts when they are unset, so a sandbox build without them
# silently talks to prod (login completes against prod, session never sticks
# on sandbox, no error shown). up.sh defaults match these; keep both in sync.
DASHBOARD_API_URL=https://sandbox-api.peridot.id
DASHBOARD_POPUP_URL=https://sandbox.peridot.id
DASHBOARD_PID_ENV=sandbox
DASHBOARD_OTHER_WORKSPACE_URL=https://dashboard.peridot.id
# Localhost-against-sandbox edge (documented: use the sandbox stack for
# localhost testing) — the one additive CORS entry still maintained per env.
CORS_ORIGINS=http://localhost:3302
# Isolated cookie domain so prod sessions never bleed into the sandbox.
# (Uncomment only if cross-subdomain visibility is needed; host-only is the
# dual-serve-safe default — see compose.yaml.)
# COOKIE_DOMAIN=.sandbox.peridot.id
CLIENT_REDIRECT_ALLOWLIST=https://live2dev.com,https://pro.live2dev.com,https://admin.live2dev.com,https://sandbox.peridot.id

# --- runtime / auth ---
NODE_ENV=production
# ANT-184 hardcoded in apps/api/src/common/app-config.ts — do NOT set:
# ACCESS_TOKEN_TTL=15m, REFRESH_TOKEN_TTL=30d,
# GOOGLE_FAMILY_MAX_AGE=90d, PASSKEY_FAMILY_MAX_AGE=365d,
# SSO_EXCHANGE_TOKEN_TTL=24h hardcoded (app-config) — do not set.
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
# Dedicated server pepper for email-OTP code hashes (ANT-285(c)). When unset,
# the pepper is HKDF-derived from JWT_REFRESH_SECRET — set the dedicated value
# in deployed envs for full key isolation. Also add to Infisical /apps/api.
EMAIL_OTP_PEPPER=CHANGE_ME_email_otp_pepper_min_32_chars
# Optional: dedicated HMAC secret for OAuth state envelopes (F1). When unset,
# the key is HKDF-derived from JWT_ACCESS_SECRET — set in deployed envs for
# full key isolation. Also add to Infisical /apps/api when set here.
# APP_TOKEN_TTL hardcoded to 1h (app-config) — do not set.
# Secret-at-rest data key (ANT-286a): 32-byte hex (64 chars) for AES-256-GCM
# envelope encryption of PidApp.webhookSecret + EvmRelayerKey.secret.
# REQUIRED in deployed envs — writes fail closed without it. Also add to
# Infisical /apps/api (dev/test/main). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# PID_SECRETS_ENC_KEY=

# Google OAuth — same client id/secret as prod; register the SANDBOX callback
# URL on that client. Never add localhost URIs to the prod client.
# API public origin — single source for the derived Google callback.
API_URL=https://sandbox-api.peridot.id
# Derived: GOOGLE_CALLBACK_URL=<API_URL>/v1/auth/google/callback.
# Override only for dual-serve edge — never in examples.
# GOOGLE_CALLBACK_URL=https://sandbox-api.peridot.id/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# COOKIE_SAMESITE derives as lax; COOKIE_SECURE derives from the API protocol (https → true).

# --- WebAuthn (sandbox RP id derives from the wallet host — generic, no pin) ---
# Pin WEBAUTHN_RP_ID explicitly only for passkey continuity when rotating
# domains with existing credentials (existing credentials are bound to it).
# WEBAUTHN_RP_ID=sandbox.peridot.id
# WEBAUTHN_RP_NAME hardcoded to PeridotID (app-config) — do not set.
# NOTE: sandbox RP_ID differs so passkeys stay isolated; RP_NAME stays shared.
# Origins always derive from the service-URL set above — WEBAUTHN_ORIGINS removed.

# --- shared infra Postgres (create first: ./deploy/db-init.sh test) ---
DATABASE_URL=postgresql://peridot_id_test:CHANGE_ME@postgres:5432/peridot_id_test

# --- Solana (chains/RPC/program id live in the DB registry — seed + admin UI) ---
# ANT-920: RELAYER_SVM_SECRET_KEY replaces PID_RELAYER_SECRET (64-byte hex or JSON 64-byte array).
RELAYER_SVM_SECRET_KEY=CHANGE_ME_64_byte_hex_or_json_array
# PID_ACTIVATION_POLL_MS / PID_ACTIVATION_CONFIRM_INTERVAL_MS /
# PID_ACTIVATION_CONFIRM_ATTEMPTS hardcoded — do not set.
# ANT-635: no PID_TREASURY_PUBKEY — the fee vault is the ["treasury"] PDA per program id.
# PID_FEE_POLICY_VERSION hardcoded to 1 — do not set.

# --- Fiat: DOKU SANDBOX ONLY on the sandbox stack ---
DOKU_MODE=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PRIVATE_KEY=
# Internal fiat ledger (money-in via DOKU Checkout; no Sub-Account).
PID_FIAT_LEDGER_ENABLED=true
PID_FIAT_LEDGER_FROZEN=false
PID_REDEMPTION_ENABLED=false
# Sandbox faucet (ANT-287 FR-2, DevOps ANT-290): server-side gate for
# POST /v1/fiat/test-credit. "true" on THIS (sandbox) stack only — the backend
# registers the route iff this is exactly "true"; production MUST keep "false"
# (route absent ⇒ 404, zero ledger writes). Also set in Infisical test env
# (/apps/api PID_FAUCET_ENABLED=true; main env =false).
PID_FAUCET_ENABLED=true
# XP & Leveling migration tooling only — intake itself is always available
# (gated only by the xp.suspend.* kill-switches in the admin dashboard).
# Migration execution stays "false" everywhere until board confirmation.
PID_XP_MIGRATION_ENABLED=false
# Faucet caps (proposed, CTO confirms via ANT-287 OQ-1): per-call max
# Rp50.000, Rp100.000 + 10 calls/identity/day. Backend hardcodes them
# (app-config philosophy); the abuse alert (deploy/alerts/) counts mints.
DOKU_WEBHOOK_URL=https://sandbox-api.peridot.id/v1/fiat/webhook

# Optional: PID promoted to admin when claimed in the sandbox.
# PID_BOOTSTRAP_ADMIN_PID=ifal@pid
