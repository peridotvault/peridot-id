# PeridotID deploy env - test / SANDBOX stack (staging + developer sandbox).
# Copy to deploy/.env.test and fill in. Never commit the filled copy.
# Usage: ./deploy/up.sh test   (separate compose project: peridot-id-test)
#
# This is PeridotID's SANDBOX: DOKU runs in sandbox mode, so real money can
# never move here. Apps (public + internal) test their integrations against it.
# Prod (.env.main) and sandbox are fully separate: DB, DOKU mode, JWT secrets,
# cookie domain, and every app registration (clientId/secret/origins/fees).

# sandbox hostnames: sandbox.pid…, api.sandbox.pid…, app.sandbox.pid…
ENV_SUFFIX=sandbox.
NAMESPACE=-test

# --- domains ---
CLIENT_SUCCESS_URL=https://app.sandbox.pid.peridotvault.com
VITE_API_URL=https://api.sandbox.pid.peridotvault.com
CORS_ORIGINS=https://app.sandbox.pid.peridotvault.com,https://sandbox.pid.peridotvault.com,https://sandbox.peridot.id,https://sandbox-dashboard.peridot.id,http://localhost:3302
# Isolated cookie domain so prod sessions never bleed into the sandbox.
COOKIE_DOMAIN=.sandbox.pid.peridotvault.com
CLIENT_REDIRECT_ALLOWLIST=https://live2dev.com,https://pro.live2dev.com,https://admin.live2dev.com,https://sandbox.pid.peridotvault.com

# --- runtime / auth ---
NODE_ENV=production
# ANT-184 hardcoded in apps/api/src/common/app-config.ts — do NOT set:
# ACCESS_TOKEN_TTL=15m, REFRESH_TOKEN_TTL=30d,
# GOOGLE_FAMILY_MAX_AGE=90d, PASSKEY_FAMILY_MAX_AGE=365d,
# SSO_EXCHANGE_TOKEN_TTL=30d hardcoded (app-config) — do not set.
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
APP_TOKEN_TTL=1h

# Google OAuth — same client id/secret as prod; register the SANDBOX callback
# URL on that client. Never add localhost URIs to the prod client.
# API public origin — single source for the derived Google callback.
API_DOMAIN=https://api.sandbox.pid.peridotvault.com
# Derived: GOOGLE_CALLBACK_URL=<API_DOMAIN>/v1/auth/google/callback.
# Override only for dual-serve edge — never in examples.
# GOOGLE_CALLBACK_URL=https://api.sandbox.pid.peridotvault.com/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COOKIE_SAMESITE=lax

# --- WebAuthn (sandbox RP id → passkeys are isolated per environment) ---
WEBAUTHN_RP_ID=sandbox.pid.peridotvault.com
# WEBAUTHN_RP_NAME hardcoded to PeridotID (app-config) — do not set.
# NOTE: sandbox RP_ID differs so passkeys stay isolated; RP_NAME stays shared.
# WEBAUTHN_ORIGINS falls back to CORS_ORIGINS when unset (dedupe: keep one list).
WEBAUTHN_ORIGINS=https://app.sandbox.pid.peridotvault.com,https://api.sandbox.pid.peridotvault.com,https://sandbox.pid.peridotvault.com

# --- shared infra Postgres (create first: ./deploy/db-init.sh test) ---
DATABASE_URL=postgresql://peridot_id_test:CHANGE_ME@postgres:5432/peridot_id_test

# --- Solana (chains/RPC/program id live in the DB registry — seed + admin UI) ---
PID_RELAYER_SECRET=CHANGE_ME_64_byte_hex
# PID_ACTIVATION_POLL_MS / PID_ACTIVATION_CONFIRM_INTERVAL_MS hardcoded — do not set.
PID_ACTIVATION_CONFIRM_ATTEMPTS=15
PID_TREASURY_PUBKEY=CHANGE_ME
PID_FEE_POLICY_VERSION=1

# --- Fiat: DOKU SANDBOX ONLY on the sandbox stack ---
DOKU_MODE=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PRIVATE_KEY=
# Internal fiat ledger (money-in via DOKU Checkout; no Sub-Account).
PID_FIAT_LEDGER_ENABLED=true
PID_FIAT_LEDGER_FROZEN=false
PID_REDEMPTION_ENABLED=false
DOKU_WEBHOOK_URL=https://api.sandbox.pid.peridotvault.com/v1/fiat/webhook

# Optional: PID promoted to admin when claimed in the sandbox.
# PID_BOOTSTRAP_ADMIN_PID=ifal@pid
