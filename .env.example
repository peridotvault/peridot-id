# =============================================================================
# PeridotID — canonical local-dev env doc (OWNER: root).
# This file is the canonical key registry for local development. It is docs-only:
# nothing reads it at runtime. Real values live in the secret store (Infisical:
# /apps/api for runtime secrets, /apps/wallet for VITE_* build args) or in an
# untracked local `.env`. Keys only below — `changeme`/empty/localhost/placeholder
# values, never real secrets.
#
# ANT-184/193: non-secret TTLs/names/knobs are HARDCODED in code
# (apps/api/src/common/app-config.ts) and MUST NOT appear here or in any
# *.env.example / compose interpolation:
#   ACCESS_TOKEN_TTL=15m, REFRESH_TOKEN_TTL=30d,
#   GOOGLE_FAMILY_MAX_AGE=90d, PASSKEY_FAMILY_MAX_AGE=365d,
#   SSO_EXCHANGE_TOKEN_TTL=30d, WEBAUTHN_RP_NAME=PeridotID,
#   PID_ACTIVATION_POLL_MS=10000, PID_ACTIVATION_CONFIRM_INTERVAL_MS=1000,
#   PID_ACTIVATION_CONFIRM_ATTEMPTS=15, PID_FEE_POLICY_VERSION=1,
#   PID_EVM_POLL_MS=30000, APP_TOKEN_TTL=1h.
# GOOGLE_CALLBACK_URL is DERIVED from API_URL as
#   <API_URL>/v1/auth/google/callback (see google.strategy.ts).
# CORS allow-list, WebAuthn origins + RP ID, wallet landing URL, and cookie
# attributes all DERIVE from the ONE service-URL set below
# (API_URL/WALLET_URL/DASHBOARD_URL/DOCS_URL) — see app-config.ts.
#
# Port precedence: PORT is the SOLE runtime var (`apps/api/src/main.ts`).
# Local dev default is 3300.
# =============================================================================

# --- meta ---
NODE_ENV=development

# --- ports (OWNER: root) ---
PORT=3300

# --- API runtime (OWNER: root) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peridot_id

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# Dedicated server pepper for email-OTP code hashes (ANT-285(c)) — REQUIRED in
# deployed envs. Long random value (32+ bytes hex). When unset, the pepper is
# HKDF-derived from JWT_REFRESH_SECRET (one-direction isolation); provision the
# dedicated value in Infisical /apps/api for full key separation.
EMAIL_OTP_PEPPER=
# Optional: dedicated HMAC secret for OAuth state envelopes. When unset, the
# key is HKDF-derived from JWT_ACCESS_SECRET (domain-separated, F1) — set this
# in deployed envs for full key isolation.
# Secret-at-rest data key (ANT-286a): 32-byte hex (64 chars) for AES-256-GCM
# envelope encryption of PidApp.webhookSecret + EvmRelayerKey.secret.
# REQUIRED in deployed envs — writes fail closed without it. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PID_SECRETS_ENC_KEY=

# API public origin + first-party service URLs (the ONE set — see header).
API_URL=http://localhost:3300
WALLET_URL=http://localhost:3302
DASHBOARD_URL=http://localhost:3303

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Unset/empty locally = dev fallback (code logged, verify() still 503s); prod must set.
BREVO_API_KEY=
CLIENT_REDIRECT_ALLOWLIST=

# Smart-account activation (Peridot-sponsored init; relayer pubkey must hold SOL).
PID_RELAYER_SECRET=
# ANT-635: no treasury env — the fee vault is the ["treasury"] PDA per program id.

# Token logos (Wasabi S3-compatible; public/tokens/… prefix is public-read).
# Empty locally = logo upload 503s with a clear error; values live in
# Infisical /apps/api (dev/test/main) and deploy/.env.$ENV fallback.
WASABI_ENDPOINT=
WASABI_REGION=
WASABI_BUCKET_NAME=
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=

# Fiat: DOKU Checkout (money-in only) + internal fiat ledger (the one balance rail).
DOKU_MODE=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PRIVATE_KEY=
DOKU_SAC_TYPE=DEFAULT

PID_REDEMPTION_ENABLED=false
PID_FIAT_LEDGER_ENABLED=true
PID_FIAT_LEDGER_FROZEN=false

# --- wallet (OWNER: root; read-allowlist: apps/wallet/.env.example, Vite public) ---
VITE_API_URL=http://localhost:3300
