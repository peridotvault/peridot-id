# =============================================================================
# PeridotID — canonical local-dev env doc (OWNER: root).
# This file is the canonical key registry for local development. It is docs-only:
# nothing reads it at runtime. Real values live in the secret store (Infisical:
# /apps/api for runtime secrets, /apps/wallet for VITE_* build args) or in an
# untracked local `.env`. Keys only below — `changeme`/empty/localhost/placeholder
# values, never real secrets (Tobias reviews posture pre-merge, ANT-158).
#
# Ownership model (spec ANT-154, rules R1–R7):
# - OWNER root (this file): every shared/local-dev key + canonical defaults.
# - Consumers reference, never re-document: per-app `*.env.example` files carry
#   ONLY the keys their runtime reads (allowlist), with a pointer comment back here.
# - OWNER deploy (`deploy/.env.{main,test}.example`): deploy-only keys
#   (ENV_SUFFIX, NAMESPACE, TAG, NEW_*_HOST, DASHBOARD_*) + refs to root keys.
#   The deploy bundle MUST stay complete for `compose.yaml` interpolation (R4);
#   `scripts/check-env-ownership.mjs` (`pnpm check:env`) enforces this in CI (R5).
# - No symlinks (R6): cross-file reuse is by pointer comment + check script.
#
# Port precedence (OQ-4 resolved for peridot-id): PORT is the SOLE runtime var
# (`apps/api/src/main.ts`: `config.get("PORT", 3300)`). There is no API_PORT in
# this repo — it is listed below as reserved/spec-parity only. Containers pin
# PORT explicitly (compose `environment: PORT: "3301"`, Dockerfiles `ENV PORT`).
# Local dev default is 3300 (see `apps/api/.env.example`).
#
# OQ-1 (WORKER_INTERNAL_TOKEN vs INTERNAL_API_TOKEN): NOT APPLICABLE here —
# this repo has no worker service and neither token exists in code/compose.
# No compose rename in this slice.
# =============================================================================

# --- meta (OWNER: root; consumers: compose `api.environment`, Dockerfiles) ---
NODE_ENV=development

# --- ports (OWNER: root) ---
# Consumers: apps/api (read-allowlist), compose (pinned, not tunable via env file).
PORT=3300
# API_PORT=3300  # reserved alias, NOT read by peridot-id runtime — do not set.

# --- API runtime (OWNER: root; read-allowlist: apps/api/.env.example) ---
# Full local values live here; apps/api/.env.example lists ONLY what its
# runtime reads.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peridot_id

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
GOOGLE_FAMILY_MAX_AGE=90d
PASSKEY_FAMILY_MAX_AGE=365d
SSO_EXCHANGE_TOKEN_TTL=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3300/v1/auth/google/callback

# Unset/empty locally = dev fallback (code logged, verify() still 503s); prod must set.
BREVO_API_KEY=

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax
CLIENT_SUCCESS_URL=http://localhost:3302
# Cross-origin SSO returnTo allowlist (comma-separated origins).
CLIENT_REDIRECT_ALLOWLIST=
# Optional extra CORS origins (include the wallet dev server :3301).
CORS_ORIGINS=http://localhost:3301

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PeridotID
WEBAUTHN_ORIGINS=http://localhost:3300,http://localhost:3301,http://localhost:5173,http://localhost:3302

# Smart-account activation (Peridot-sponsored init; relayer pubkey must hold SOL).
PID_RELAYER_SECRET=
PID_ACTIVATION_POLL_MS=10000
PID_ACTIVATION_CONFIRM_ATTEMPTS=15
PID_ACTIVATION_CONFIRM_INTERVAL_MS=1000
PID_TREASURY_PUBKEY=
PID_FEE_POLICY_VERSION=1

# EVM counterfactual accounts (testnet/dev-only; unset = EVM rows skipped, /evm/* 503s).
EVM_FACTORY_ADDRESS=
EVM_IMPLEMENTATION_ADDRESS=
EVM_RPC_URL=https://rpc.ankr.com/eth_sepolia
PID_EVM_POLL_MS=30000

# Fiat: DOKU Checkout (money-in only) + internal fiat ledger (the one balance rail).
DOKU_MODE=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PRIVATE_KEY=
DOKU_SAC_TYPE=DEFAULT
PID_REDEMPTION_ENABLED=false
# Internal fiat ledger (default enabled; frozen blocks new issues/sends).
PID_FIAT_LEDGER_ENABLED=true
PID_FIAT_LEDGER_FROZEN=false

# --- wallet (OWNER: root; read-allowlist: apps/wallet/.env.example, Vite public) ---
VITE_API_URL=http://localhost:3300
# VITE_NETWORK_MODE=testnet  # optional; anything else (or unset) = mainnet default.

# --- dashboard (OWNER: deploy; no apps/dashboard/.env.example yet — Thomas, ANT-156) ---
# Canonical dashboard build args live in deploy overlays + up.sh per-stack
# defaults (DASHBOARD_API_URL / DASHBOARD_POPUP_URL / DASHBOARD_PID_ENV, plus
# DASHBOARD_PID_CLIENT_ID / DASHBOARD_OTHER_WORKSPACE_URL defaulted in compose).
# Do NOT add VITE_* dashboard keys here as values — deploy owns them.

# --- deploy-only (OWNER: deploy; MUST NEVER appear in root values or app examples) ---
# ENV_SUFFIX, NAMESPACE, TAG, NEW_API_HOST, NEW_WALLET_HOST, NEW_DASHBOARD_HOST,
# NEW_DOCS_HOST — see deploy/.env.{main,test}.example. up.sh also exports
# per-stack defaults for these; env-file values win when set.

# --- optional / spec-parity (NOT read by peridot-id runtime — do not set) ---
# The following names come from spec ANT-154 for cross-repo parity. Grep confirms
# no reader in apps/api/src, compose.yaml, Dockerfiles, or up.sh. Kept as
# comments so future adoption picks the canonical names instead of inventing new ones.
# SKIP_MIGRATION_CHECK=0
# CONFIRM_DESTRUCTIVE_MIGRATIONS=0
# NEST_LOG_LEVELS=
# PRISMA_DEBUG_QUERIES=
# PRISMA_MIGRATIONS_DIR=
