# Root .env is for docker-compose (Postgres/Redis infra credentials).
# The current docker-compose.yml hardcodes postgres:postgres and does not
# interpolate from this file yet.
#
# RUNTIME config for the API lives in apps/api/.env — see apps/api/.env.example.
# NestJS and the Prisma CLI both load .env from their working directory (apps/api).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=peridot
