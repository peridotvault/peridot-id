{
  "name": "@peridotvault/pid-evm",
  "version": "0.1.0",
  "description": "PeridotID EVM adapter — CREATE2 counterfactual addresses and passkey-account calldata on top of pid-core. No web3.js, no viem; plain JSON-RPC.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@peridotvault/pid-core": "workspace:*",
    "@peridotvault/pid-types": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
