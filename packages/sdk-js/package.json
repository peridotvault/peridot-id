{
  "name": "@peridotvault/pid-sdk-js",
  "version": "1.9.1",
  "description": "The PeridotID browser SDK \u2014 auth (Google + passkey), identity, profile, and the passkey wallet (non-custodial Solana smart account).",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/peridotvault/peridot-id.git"
  },
  "keywords": [
    "peridot",
    "solana",
    "passkey",
    "webauthn",
    "wallet",
    "smart-account"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@peridotvault/pid-core": "workspace:*",
    "@peridotvault/pid-payments": "workspace:*",
    "@peridotvault/pid-solana": "workspace:*",
    "@peridotvault/pid-types": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node -e \"require('fs').mkdirSync('dist/cjs',{recursive:true});require('fs').mkdirSync('dist/esm',{recursive:true});require('fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}));require('fs').writeFileSync('dist/esm/package.json',JSON.stringify({type:'module'}));\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm build",
    "test": "node --test test/env.test.mjs test/popup.test.mjs test/fiat.test.mjs test/bearer.test.mjs test/embed.test.mjs test/chain-echo.test.mjs test/level.test.mjs test/fee-quote.test.mjs test/fee-quote-ws4.test.mjs test/fee-v2-activate.test.mjs",
    "prepack": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node -e \"require('fs').mkdirSync('dist/cjs',{recursive:true});require('fs').mkdirSync('dist/esm',{recursive:true});require('fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}));require('fs').writeFileSync('dist/esm/package.json',JSON.stringify({type:'module'}));\""
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  }
}
