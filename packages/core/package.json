{
  "name": "@peridotvault/pid-core",
  "version": "0.2.1",
  "description": "PeridotID core primitives — encoding, domain-separated hashes, WebAuthn ceremonies, and client key custody. No redirects, no hosts, no app flow.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@peridotvault/pid-types": "workspace:*",
    "@solana/web3.js": "^1.98.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node -e \"require('fs').mkdirSync('dist/esm',{recursive:true});require('fs').writeFileSync('dist/esm/package.json',JSON.stringify({type:'module'}));\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm build",
    "test": "node --test \"test/*.test.mjs\"",
    "prepack": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node -e \"require('fs').mkdirSync('dist/esm',{recursive:true});require('fs').writeFileSync('dist/esm/package.json',JSON.stringify({type:'module'}));\""
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  },
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/*": {
      "import": {
        "types": "./dist/esm/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "require": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peridotvault/peridot-id.git",
    "directory": "packages/core"
  },
  "homepage": "https://docs.peridot.id"
}
